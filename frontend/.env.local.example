# =============================================================================
# PakSwap Frontend — Environment Variables
# Copy this to .env.local for local development.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# =============================================================================

# Backend API URL — base origin only.
# The client appends `/api/v1` itself, so do NOT include `/api`, `/api/v1`, or a trailing slash.
# Local:      http://localhost:3001
# Production: https://YOUR_BACKEND.up.railway.app
# In Vercel, set this in Settings → Environment Variables for Production, Preview, Development.
NEXT_PUBLIC_API_URL=http://localhost:3001

# WalletConnect / Reown AppKit (Web3 wallet connections)
# Required for MetaMask, WalletConnect v2, Coinbase Wallet, OKX, Rabby, Bitget, etc.
# Get from: https://cloud.reown.com (free tier covers indie projects)
# Without it: injected wallets like MetaMask still work; mobile/WC pairings fail.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Analytics (Posthog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Error monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=

# Push notifications (Web Push — must match backend VAPID keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Customer support widget (Crisp)
# Get from: https://crisp.chat → Settings → Website → Copy website ID
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Cloudflare Turnstile (bot protection)
# Get from: https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
