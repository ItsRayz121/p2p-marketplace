# ─── Backend ──────────────────────────────────────────────────────────────────
# Full URL to the backend API (no trailing slash).
# Dev: leave empty — Next.js rewrites /api/* to http://localhost:3001/api/*
# Prod: set to your Railway / Render backend URL
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# ─── SEO / OG ─────────────────────────────────────────────────────────────────
# Public-facing site URL — used in sitemap.xml, robots.txt, and OG canonical URLs.
# MUST match the actual deployment domain exactly (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://rupchain.com

# ─── Analytics ────────────────────────────────────────────────────────────────
# PostHog project key (get from posthog.com → Project Settings → API Key)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Live chat (optional) ─────────────────────────────────────────────────────
# Crisp website ID — leave empty to disable the chat widget
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ─── WalletConnect / Reown ────────────────────────────────────────────────────
# Project ID from cloud.reown.com (required for WalletConnect QR modal)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
