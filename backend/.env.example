# =============================================================================
# PakSwap Backend — Environment Variables
# Copy this file to .env and fill in all values before starting the server.
# The server WILL NOT START if required variables are missing.
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# --- Database (Railway auto-injects DATABASE_URL in production) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/pakswap_dev

# --- Redis (Railway auto-injects REDIS_URL in production) ---
REDIS_URL=redis://localhost:6379

# --- Auth Secrets (generate with: openssl rand -hex 32) ---
JWT_SECRET=REPLACE_ME_32_CHARS_MIN
JWT_REFRESH_SECRET=REPLACE_ME_32_CHARS_MIN
CSRF_SECRET=REPLACE_ME_32_CHARS_MIN

# --- CRITICAL: Server refuses to start without this ---
# Used to HMAC-SHA256 CNIC numbers before storing — never store plaintext CNICs
CNIC_HASH_SECRET=REPLACE_ME_32_CHARS_MIN

# --- Cloudinary (file storage — KYC docs, payment proof screenshots) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Resend (transactional email) ---
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="PakSwap <noreply@pakswap.pk>"

# --- Frontend URL (for CORS and email links) ---
FRONTEND_URL=http://localhost:3000

# --- Rate Exchange APIs ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
EXCHANGERATE_API_KEY=

# --- Blockchain Monitoring (Moralis or Tatum — Phase 2) ---
MORALIS_API_KEY=
MORALIS_WEBHOOK_SECRET=
TATUM_API_KEY=
TATUM_WEBHOOK_SECRET=
BLOCKCYPHER_TOKEN=

# --- Blockchain RPCs ---
TRON_FULL_NODE_URL=https://api.trongrid.io
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=

# --- Gas Fee System ---
# Separate deposit address from P2P deposit addresses
GAS_FEE_DEPOSIT_ADDRESS_TRC20=
# Private key stored securely — NEVER put real key in .env in production
# For local dev only (Phase 1 testing):
GAS_WALLET_PRIVATE_KEY_TRON=
GAS_WALLET_SECRET_ARN_TRON=
GAS_WALLET_ALERT_THRESHOLD_TRON=5000
GAS_WALLET_PAUSE_THRESHOLD_TRON=1000
GAS_MARKUP_MULTIPLIER_TRON=1.50
COINGECKO_API_KEY=
# FreeCryptoApi — free tier (100K quotes/month, USD only). Sign up at freecryptoapi.com
FREECRYPTOAPI_KEY=

# --- P2P Platform Deposit Addresses (legacy shared addresses — fallback only) ---
# EVM networks (ERC20/BEP20/POLYGON/ARBITRUM/OPTIMISM/BASE) now use per-user
# HD-derived addresses (see WALLET_MASTER_KEY below). These three remain only
# as a fallback for environments where HD custody is not yet bootstrapped.
PLATFORM_DEPOSIT_USDT_TRC20=
PLATFORM_DEPOSIT_USDT_BEP20=
PLATFORM_DEPOSIT_USDT_ERC20=

# --- Moralis Streams per-chain ids ---
# Create one Stream per chain in the Moralis dashboard pointing at
# https://YOUR_BACKEND/api/v1/webhooks/deposit and paste the Stream ID here.
# Leave blank for chains you don't want to monitor yet — the subscribe worker
# marks their rows as status=skipped.
MORALIS_STREAM_ID_ETHEREUM=
MORALIS_STREAM_ID_BSC=
MORALIS_STREAM_ID_POLYGON=
MORALIS_STREAM_ID_ARBITRUM=
MORALIS_STREAM_ID_OPTIMISM=
MORALIS_STREAM_ID_BASE=

# --- Wallet HD-derivation custody ---
# Generate a 32-byte (64-hex) key:   openssl rand -hex 32
# Then run:                          npm run wallet:bootstrap
# The script prints WALLET_MASTER_SEED_CIPHERTEXT — paste that value below.
# WARNING: anyone with both values can derive every user deposit address.
WALLET_MASTER_KEY=
WALLET_MASTER_SEED_CIPHERTEXT=

# --- Push Notifications (Firebase) ---
FCM_SERVER_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@pakswap.pk
FIREBASE_SERVICE_ACCOUNT=

# --- Bot Detection (Cloudflare Turnstile) ---
TURNSTILE_SECRET_KEY=

# --- Error Monitoring ---
SENTRY_DSN=

# --- Analytics ---
POSTHOG_API_KEY=

# --- Alerts ---
ADMIN_ALERT_EMAIL=ops@pakswap.pk
