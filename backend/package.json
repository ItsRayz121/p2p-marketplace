{
  "name": "@pakswap/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:migrate": "prisma migrate resolve --rolled-back 20260515190000_gas_treasury_ledger_refill 2>/dev/null || true && prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "workers": "tsx src/queues/workers.ts",
    "wallet:bootstrap": "tsx src/scripts/walletBootstrap.ts",
    "gas:encrypt-mnemonic": "tsx src/scripts/encryptGasMnemonic.ts",
    "moralis:backfill": "prisma generate && tsx src/scripts/moralisBackfill.ts",
    "deploy:verify": "tsx src/scripts/deployVerify.ts",
    "deploy:verify:full": "tsx src/scripts/deployVerify.ts --full"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.16.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.11",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.12.0",
    "cloudinary": "^2.3.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "otplib": "^13.4.0",
    "pino": "^9.3.1",
    "pino-pretty": "^11.2.1",
    "prisma": "^5.16.0",
    "qrcode": "^1.5.4",
    "resend": "^4.0.0",
    "tronweb": "^6.3.0",
    "typescript": "^5.9.3",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.16.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
