enum GasFeeOrderStatus {
  created
  payment_pending
  payment_uploaded
  payment_verified
  payment_detected
  sending
  delivered
  expired
  failed
  awaiting_refund
  refund_pending
  refunded
  cancelled
}

enum GasCustomRequestStatus {
  pending
  reviewing
  completed
  rejected
}

enum GasLedgerEntryType {
  order_payment        // user USDT payment received into hot wallet
  gas_delivery         // native gas sent to user
  delivery_refund      // native gas refunded to user (failed delivery)
  refill_hot_from_treasury  // treasury â†’ hot wallet transfer
  drain_hot_to_treasury     // hot wallet â†’ treasury (emergency drain)
  platform_fee         // platform fee collected from user withdrawals (stays in hot wallet)
  platform_fee_sweep   // accumulated platform fees swept from hot wallet → treasury wallet
  external_hot_wallet_deposit  // direct native-token send to hot wallet (e.g. admin top-up)
  platform_revenue_withdrawal  // platform-owned funds withdrawn from hot wallet → external wallet
}

enum GasRefillRequestStatus {
  pending_approval  // waiting for admin approval (when approval mode is on)
  approved          // admin approved, waiting for execution
  executing         // tx in-flight
  completed         // tx confirmed
  failed            // tx failed, see failureReason
  cancelled         // cancelled by admin before execution
}

enum RateAlertDirection {
  above
