enum UserRole {
  user
  merchant
  kyc_reviewer
  dispute_agent
  support_agent
  admin
  super_admin
}

enum KycStatus {
  none
  pending
  approved
  rejected
}

enum KycLevel {
  none
  basic
  enhanced
}

enum AdSide {
  buy
  sell
}

enum PriceType {
  fixed
  float
}

enum AdStatus {
  active
  paused
  completed
}

enum TradeStatus {
  payment_pending
  payment_uploaded
  payment_confirmed
  crypto_sent
  crypto_released
  cancelled
  disputed
  dispute_resolved
}

enum InstantBuyStatus {
  payment_pending
  payment_uploaded
  admin_review
  completed
  rejected
  expired
}

enum VerificationStatus {
  pending_layer1
  layer1_passed
  layer1_failed
  layer2_approved
  layer2_rejected
}

enum PaymentMode {
  pkr
  crypto
}

enum DisputeStatus {
  open
  under_review
  escalated
  awaiting_evidence
  resolved
}

enum DisputeWinner {
  buyer
  seller
}

enum DisputeResolutionType {
  buyer_wins
  seller_wins
  split
  // No admin ruling — the parties finished both legs themselves after the dispute
  // was opened and the trade completed, so the dispute closed on its own. Carries
  // NO fault: no bond seizure, no points clawback, no winner.
  settled_by_parties
  // Admin closed the case without ruling against anyone (misunderstanding, opened
  // in error, both sides made whole off-platform). Same no-fault guarantees as
  // settled_by_parties, but admin-initiated. NEITHER party is affected.
  dismissed
}

