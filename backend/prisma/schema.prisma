// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// TRUST & STATS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TradeStats {
  id               String      @id @default(cuid())
  userId           String      @unique
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalTrades      Int         @default(0)
  completedTrades  Int         @default(0)
  cancelledTrades  Int         @default(0)
  completionRate   Decimal     @default(0) @db.Decimal(5, 4)
  avgRating        Decimal     @default(0) @db.Decimal(3, 2)
  totalReviews     Int         @default(0)
  totalVolumePKR   Decimal     @default(0) @db.Decimal(18, 2)
  trustScore       Int         @default(0)
  badge              TraderBadge @default(new)
  badgeLabel         String      @default("New Trader")
  badgeOverride      Boolean     @default(false)
  avgResponseMinutes Int?        // median seller response time in minutes (null = not enough data)
  avgReleaseMinutes  Int?        // median time from payment_confirmed to crypto_released (null = not enough data)
  disputesWon        Int         @default(0)
  disputesLost       Int         @default(0)
  lastUpdated        DateTime    @updatedAt
}

model UserFavorite {
  id              String   @id @default(cuid())
  userId          String
  favBy           User     @relation("FavoritingUser", fields: [userId], references: [id], onDelete: Cascade)
  favoritedUserId String
  favOf           User     @relation("FavoritedTrader", fields: [favoritedUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([userId, favoritedUserId])
  @@index([userId])
}

// ──────────────────────────────────────────────────────────────────────────────
// MUTUAL TRADE STREAKS
// A single row per unordered pair of users, holding their COMBINED completed-trade
// count across every pillar (USDT P2P + CTM). userAId is always the
// lexicographically smaller id so each pair maps to exactly one row. The count is
// incremented inside the same transaction that completes a trade.
// ──────────────────────────────────────────────────────────────────────────────
model TradeStreak {
  id           String   @id @default(cuid())
  userAId      String   // always the smaller of the two ids
  userA        User     @relation("StreakUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId      String
  userB        User     @relation("StreakUserB", fields: [userBId], references: [id], onDelete: Cascade)
  tradeCount   Int      @default(0) // combined completed trades between the pair
  firstTradeAt DateTime @default(now())
  lastTradeAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PERSISTENT COUNTERPARTY MESSAGING (Phase 4)
// One permanent thread per unordered pair of users (canonical userAId < userBId,
// mirroring TradeStreak). Reused across every trade the two ever do — each trade
// is a TradeEpisode marker within the thread. Trade-gated: a thread only ever
// exists once the pair has actually traded (no cold DMs). Modeled on
// SupportConversation (persistent conversation + dated sub-sessions).
// ─────────────────────────────────────────────────────────────────────────────

model ChatThread {
  id            String              @id @default(cuid())
  userAId       String              // always the smaller of the two ids
  userA         User                @relation("ChatThreadUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId       String
  userB         User                @relation("ChatThreadUserB", fields: [userBId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime            @default(now())
  unreadByA     Boolean             @default(false)
  unreadByB     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  messages      ChatThreadMessage[]
  episodes      TradeEpisode[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model ChatThreadMessage {
  id            String     @id @default(cuid())
  threadId      String
  thread        ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId      String     // the author's user id ("" for platform/system lines)
  body          String     @db.VarChar(2000)
  attachmentUrl String?
  // Soft delete: retracted by its author. Row is retained; the counterparty sees a
  // "message was deleted" tombstone. Never hard-deleted (dispute evidence).
  deletedAt     DateTime?
  isSystem      Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([threadId, createdAt])
}

/// One marker per trade the pair opens, rendered as a divider in the thread and
/// feeding the relationship stats header. Spans BOTH markets via (market, tradeId).
model TradeEpisode {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  market     String     // 'usdt' | 'ctm'
  tradeId    String     // Trade.id or CtmTrade.id
  tradeRef   String     // orderRef / displayRef for display + deep-linking
  outcome    String     @default("active") // active | completed | cancelled | expired | disputed
  fiatAmount Decimal?   @db.Decimal(14, 2)
  startedAt  DateTime   @default(now())
  endedAt    DateTime?
  createdAt  DateTime   @default(now())

  @@unique([market, tradeId])
  @@index([threadId, startedAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// RATE ALERTS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model RateAlert {
