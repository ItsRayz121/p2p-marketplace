// Immutable record of every moderation action taken against a user.
// One row per action (suspend, ban, unban, restore, reset-trust, review toggle).
model ModerationAction {
  id             String   @id @default(cuid())
  targetUserId   String
  targetUser     User     @relation("ModerationActionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  moderatorId    String?  // null = system action (e.g. automatic expiry)
  moderator      User?    @relation("ModerationActionModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  action         String   // suspend | ban_temporary | ban_permanent | unsuspend | unban | restore_access | reset_trust | start_review | end_review | auto_unsuspend | auto_unban
  reason         String   @db.VarChar(1000)
  previousStatus String   // computed moderation status before the action
  newStatus      String   // computed moderation status after the action
  durationLabel  String?  // human label e.g. "7 Days" / "Permanent" / "Custom"
  expiresAt      DateTime? // when the applied restriction auto-lifts (null = permanent / N/A)
  createdAt      DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([moderatorId])
  @@index([action])
}

// User-submitted appeal against a ban or suspension.
model Appeal {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation("AppealUser", fields: [userId], references: [id], onDelete: Cascade)
  status        AppealStatus @default(pending)
  subjectStatus String       // moderation status being appealed (suspended / temporarily_banned / permanently_banned)
  explanation   String       @db.VarChar(2000)
  evidenceUrls  String[]     @default([])
  reviewedById  String?
  reviewedBy    User?        @relation("AppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  decisionNote  String?      @db.VarChar(1000)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

