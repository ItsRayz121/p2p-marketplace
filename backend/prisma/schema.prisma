// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// CORE MODELS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  fullName      String
  username      String    @unique
  passwordHash  String

  role          UserRole  @default(user)
  intendedRole  String    @default("user")

  kycStatus     KycStatus @default(none)
  kycLevel      KycLevel  @default(none)

  referralCode  String    @unique @default(cuid())
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]    @relation("Referrals")

  twoFaEnabled  Boolean   @default(false)
  twoFaSecret   String?

  // Withdrawal security lock â€” set after password/email/2FA changes.
  // requestWithdrawal checks this before creating any withdrawal.
  withdrawalLockedUntil DateTime?
  withdrawalLockReason  String?   @db.VarChar(200)

  isEmailVerified        Boolean @default(false)
  isSuspended            Boolean @default(false)
  isBanned               Boolean @default(false)
  suspendReason          String?

  dailyBuyUsed           Decimal @default(0) @db.Decimal(14, 2)
  dailyBuyReset          DateTime?
  monthlyBuyUsed         Decimal @default(0) @db.Decimal(14, 2)
  monthlyBuyReset        DateTime?
  dailyBuyLimit          Decimal @default(50000) @db.Decimal(14, 2)
  dailySellLimit         Decimal @default(50000) @db.Decimal(14, 2)

  completedSellTrades    Int     @default(0)
  firstTradeBonusPaid    Boolean @default(false)
  marketingEmailsEnabled Boolean @default(true)

  socialLinks            Json    @default("{}")
  socialLinksPublic      Boolean @default(false)

  termsAcceptedAt        DateTime?
  termsVersion           String?

  lastSeenAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations â€” onDelete rules are explicit (no implicit RESTRICT surprises)
  wallets                Wallet[]
  trades                 Trade[]             @relation("TradeBuyer")
  sellTrades             Trade[]             @relation("TradeSeller")
  ads                    Ad[]
  instantBuyOrders       InstantBuyOrder[]
  kycSubmissions         KycSubmission[]
  paymentMethods         PaymentMethod[]
  savedAddresses         SavedAddress[]
  withdrawals            Withdrawal[]
  collateralLocks        CollateralLock[]
  referralRewardsGiven   ReferralReward[]    @relation("ReferralRewardsGiven")
  referralRewardsEarned  ReferralReward[]    @relation("ReferralRewardsEarned")
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  sessions               Session[]
  tradeStats             TradeStats?
  merchant               Merchant?
  fraudFlags             FraudFlag[]
  rateAlerts             RateAlert[]
  adminNotes             AdminNote[]         @relation("AdminNoteTarget")
  auditLogs              AuditLog[]
  gasFeeOrders           GasFeeOrder[]
  merchantApiKeys        MerchantApiKey[]
  depositAddresses       DepositAddress[]
  deposits               Deposit[]
  trustedAddresses       TrustedWithdrawalAddress[]
  ctmTokenRequests       CtmTokenRequest[]
  ctmMerchantProfile     CtmMerchantProfile?
  ctmBuyTrades           CtmTrade[]            @relation("CtmTradeBuyer")
  ctmSellTrades          CtmTrade[]            @relation("CtmTradeSeller")
  ctmRequests            CtmRequest[]          @relation("CtmRequestUser")
  ctmBids                CtmBid[]              @relation("CtmBidder")
  ctmListingBids         CtmListingBid[]       @relation("CtmListingBidder")

  @@index([email])
  @@index([username])
  @@index([referralCode])
}

model Wallet {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  coin           String
  network        String
  balance        Decimal  @default(0) @db.Decimal(18, 8)
  lockedBalance  Decimal  @default(0) @db.Decimal(18, 8)
  depositAddress String?

  transactions   Transaction[]

  @@unique([userId, coin, network], name: "userId_coin_network")
  @@index([userId])
}

model Transaction {
  id        String          @id @default(cuid())
  walletId  String
  wallet    Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type      TransactionType
  amount    Decimal         @db.Decimal(18, 8)
  fee       Decimal         @default(0) @db.Decimal(18, 8)
  txHash    String?
  status    String          @default("completed")
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now())

  @@index([walletId])
  @@index([txHash])
}

// Withdrawal â€” tiered risk-based approval flow
// Tier 1 (<$200, no flags): auto_approved â†’ mark-sent directly
// Tier 2 ($200â€“$500, or tier 1 with risk flags): pending â†’ 1 admin â†’ approved
// Tier 3 ($500â€“$2000): pending â†’ first_approved â†’ approved (2 admins)
// Tier 4 (>$2000): on_hold â†’ admin reviews â†’ pending â†’ tier 3 flow
model Withdrawal {
  id               String           @id @default(cuid())
  orderRef         String           @unique
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  coin             String
  network          String
  amount           Decimal          @db.Decimal(18, 8)
  fee              Decimal          @default(0) @db.Decimal(18, 8)
  toAddress        String
  status           WithdrawalStatus @default(pending)
  tier             Int              @default(3)
  riskScore        Int              @default(0)
  riskFlags        String[]         @default([])
  amountUsd        Decimal?         @db.Decimal(18, 2)
  txHash           String?
  firstApprovedBy  String?
  secondApprovedBy String?
  rejectedBy       String?
  rejectionReason  String?          @db.VarChar(500)
  adminNote        String?          @db.VarChar(500)
  onHoldBy         String?
  onHoldReason     String?          @db.VarChar(500)
  riskOverride     Boolean          @default(false)
  riskOverrideBy   String?
  riskOverrideNote String?          @db.VarChar(500)
  // Email confirmation channel support â€” extensible to 'telegram' later
  confirmationChannel  String   @default("email")
  confirmationSentAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  completedAt      DateTime?

  @@index([userId, status])
  @@index([status])
  @@index([orderRef])
}

// Single-row config for withdrawal tier thresholds and risk rules.
// id is always 1; use upsert to create or update.
model WithdrawalTierConfig {
  id                    Int      @id @default(1)
  tier1MaxUsd           Decimal  @default(200)  @db.Decimal(10, 2)
  tier2MaxUsd           Decimal  @default(500)  @db.Decimal(10, 2)
  tier3MaxUsd           Decimal  @default(2000) @db.Decimal(10, 2)
  autoApproveEnabled    Boolean  @default(true)
  firstWithdrawalReview Boolean  @default(true)
  newWalletReview       Boolean  @default(true)
  velocityWindowMins    Int      @default(60)
  velocityMaxCount      Int      @default(3)
  // JSON map of coin â†’ USD price used to bucket withdrawals into tiers.
  // Example: {"USDT":1,"BNB":600,"ETH":3000,"BTC":60000}
  coinPricesUsd         Json     @default("{\"USDT\":1,\"USDC\":1,\"BNB\":600,\"ETH\":3000,\"BTC\":60000}")
  // Phase 1 / Phase 3 security knobs
  emailConfirmationEnabled  Boolean @default(true)
  emailConfirmationTtlMins  Int     @default(15)   // how long the confirm link is valid
  addressActivationHours    Int     @default(24)   // delay before a new trusted address is usable
  updatedAt             DateTime @updatedAt
  updatedBy             String?
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// P2P TRADING
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Ad {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  side            AdSide
  coin            String
  network         String
  priceType       PriceType @default(fixed)
  price           Decimal   @db.Decimal(14, 2)
  floatOffset     Decimal   @default(0) @db.Decimal(6, 4)
  totalAmount     Decimal   @db.Decimal(18, 8)
  availableAmount Decimal   @db.Decimal(18, 8)
  lockedAmount    Decimal   @default(0) @db.Decimal(18, 8)
  minOrder        Decimal   @db.Decimal(14, 2)
  maxOrder        Decimal   @db.Decimal(14, 2)
  paymentMethods  String[]
  tradeWindow     Int       @default(30)
  terms           String    @default("") @db.VarChar(2000)
  status          AdStatus  @default(active)
  lastPriceUpdate DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trades          Trade[]

  @@index([side, coin, status])
  @@index([userId])
}

model Trade {
  id                 String      @id @default(cuid())
  orderRef           String      @unique
  adId               String
  ad                 Ad          @relation(fields: [adId], references: [id], onDelete: Restrict)
  buyerId            String
  buyer              User        @relation("TradeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId           String
  seller             User        @relation("TradeSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  coin               String
  network            String
  amount             Decimal     @db.Decimal(18, 8)
  price              Decimal     @db.Decimal(14, 2)
  fiatAmount         Decimal     @db.Decimal(14, 2)
  paymentMethod        String
  status               TradeStatus @default(payment_pending)
  paymentProofUrl      String?
  buyerWalletAddress   String      @default("")
  buyerDeliveryMethod  String?     // 'blockchain' | 'email' | 'username' | 'internal'
  buyerDeliveryAddress String?     // the receiving address / email / username
  sellerTxHash         String?
  escrowReleased     Boolean     @default(false)
  cancelledBy        String?
  cancelReason       String?
  cancelledAt        DateTime?
  expiresAt          DateTime
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  messages           TradeMessage[]
  dispute            Dispute?
  ratings            TradeRating[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([orderRef])
  @@index([adId])
  @@index([status, expiresAt])
}

model TradeMessage {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  senderId      String
  message       String   @db.VarChar(500)
  attachmentUrl String?
  createdAt     DateTime @default(now())

  @@index([tradeId])
}

model Dispute {
  id             String                @id @default(cuid())
  tradeId        String                @unique
  trade          Trade                 @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  openedById     String
  reason         String
  description    String                @db.VarChar(5000)
  status         DisputeStatus         @default(open)
  resolution     String?               @db.VarChar(2000)
  winner         DisputeWinner?
  resolutionType DisputeResolutionType?
  escalatedAt    DateTime?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  messages       DisputeMessage[]

  @@index([status])
}

model DisputeMessage {
  id          String   @id @default(cuid())
  disputeId   String
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId    String
  message     String   @db.VarChar(2000)
  evidenceUrl String?
  createdAt   DateTime @default(now())

  @@index([disputeId])
}

model TradeRating {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade    @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  ratedByUserId String
  ratedUserId   String
  rating        Int
  comment       String?  @db.VarChar(500)
  tags          String[]
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([tradeId, ratedByUserId])
  @@index([ratedUserId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// INSTANT BUY (OTC)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model InstantBuyOrder {
  id                   String             @id @default(cuid())
  orderRef             String             @unique
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  coin                 String
  network              String
  paymentMode          PaymentMode
  fiatAmount           Decimal?           @db.Decimal(14, 2)
  coinAmount           Decimal            @db.Decimal(18, 8)
  rate                 Decimal            @db.Decimal(14, 2)
  fee                  Decimal            @db.Decimal(14, 4)
  status               InstantBuyStatus   @default(payment_pending)
  verificationStatus   VerificationStatus @default(pending_layer1)
  paymentProofUrl      String?
  paymentProofHash     String?
  incomingTxHash       String?
  toAddress            String
  quoteExpiresAt       DateTime
  rejectionReason      String?            @db.VarChar(500)
  ocrConfidence        Int?
  ocrExtractedAmount   Decimal?           @db.Decimal(14, 2)
  resubmitCount        Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, status])
  @@index([orderRef])
  @@index([paymentProofHash])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// KYC
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model KycSubmission {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          KycStatus         @default(pending)
  tier            KycSubmissionTier @default(basic)
  frontUrl        String
  backUrl         String
  selfieUrl       String
  cnicNumberHash  String
  socialLinks     Json              @default("[]")
  rejectionReason String?           @db.VarChar(500)
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime          @default(now())

  @@index([userId])
  @@index([cnicNumberHash])
}

model MerchantKycSubmission {
  id                  String            @id @default(cuid())
  userId              String
  businessName        String
  businessDescription String            @db.VarChar(1000)
  contactPhone        String
  businessProofType   BusinessProofType
  cnicFrontUrl        String
  cnicBackUrl         String
  selfieUrl           String
  businessProofUrl    String
  socialLinks         Json              @default("[]")
  status              KycStatus         @default(pending)
  rejectionReason     String?           @db.VarChar(500)
  reviewedAt          DateTime?
  reviewedBy          String?
  createdAt           DateTime          @default(now())

  @@index([userId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PAYMENTS & WALLET
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model PaymentMethod {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          PaymentMethodType
  displayName   String
  accountName   String
  mobileNumber  String?
  bankName      String?
  ibanNumber    String?
  accountNumber String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())

  @@index([userId])
}

model SavedAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coin      String
  network   String
  address   String
  label     String

  @@unique([userId, coin, network, address])
  @@index([userId])
}

// Trusted withdrawal addresses â€” addresses a user has explicitly whitelisted.
// Newly-added addresses have a 24h activation delay before they can be used.
// Withdrawals to non-whitelisted addresses raise the NEW_WALLET risk flag.
model TrustedWithdrawalAddress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coin        String
  network     String
  address     String
  label       String   @db.VarChar(100)
  activatesAt DateTime                    // addedAt + activationHours
  addedAt     DateTime @default(now())
  lastUsedAt  DateTime?
  removedAt   DateTime?                   // soft-delete

  @@unique([userId, coin, network, address])
  @@index([userId])
  @@index([userId, removedAt])
}

model CollateralLock {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  coin        String           @default("USDT")
  amount      Decimal          @db.Decimal(18, 8)
  status      CollateralStatus @default(locked)
  lockedAt    DateTime         @default(now())
  unlockedAt  DateTime?
  seizedAt    DateTime?
  seizeReason String?

  @@index([userId, status])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// MERCHANT
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Merchant {
  id                  String         @id @default(cuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessName        String
  status              MerchantStatus @default(pending)
  spreadBps           Int            @default(0)
  approvedAt          DateTime?
  rank                MerchantRank   @default(bronze)
  rankUpdatedAt       DateTime?
  disputeRate         Decimal        @default(0) @db.Decimal(6, 4)
  socialLinks         Json           @default("{}")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  inventory           MerchantInventory[]
  ctmProfile          CtmMerchantProfile?
}

model MerchantInventory {
  id              String   @id @default(cuid())
  merchantId      String
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  coin            String
  network         String
  availableAmount Decimal  @db.Decimal(18, 8)
  pricePerUnit    Decimal  @db.Decimal(14, 2)
  updatedAt       DateTime @updatedAt

  @@index([merchantId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// REFERRAL
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ReferralReward {
  id           String               @id @default(cuid())
  referrerId   String
  referrer     User                 @relation("ReferralRewardsGiven", fields: [referrerId], references: [id], onDelete: Restrict)
  referredId   String
  referred     User                 @relation("ReferralRewardsEarned", fields: [referredId], references: [id], onDelete: Restrict)
  status       ReferralRewardStatus @default(pending)
  rewardAmount Decimal              @db.Decimal(14, 2)
  paidAt       DateTime?
  createdAt    DateTime             @default(now())

  @@index([referrerId, status])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// NOTIFICATIONS & COMMS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  metadata  Json     @default("{}")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  keys      Json
  userAgent String?
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String?
  template  String
  toEmail   String
  status    String   @default("sent")
  sentAt    DateTime @default(now())

  @@index([userId])
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  type      String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model Session {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SessionType @default(refresh)
  token     String      @unique
  userAgent String?
  ip        String?
  createdAt DateTime    @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ADMIN NOTIFICATIONS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum AdminNotifCategory {
  KYC
  TRADE
  GAS
  DISPUTE
  CTM
  SYSTEM
}

model AdminNotification {
  id        String               @id @default(cuid())
  category  AdminNotifCategory
  title     String
  body      String
  href      String?
  isRead    Boolean              @default(false)
  metadata  Json                 @default("{}")
  createdAt DateTime             @default(now())

  @@index([isRead, createdAt])
  @@index([category, createdAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PLATFORM ADMIN
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
}

model AdminNote {
  id             String   @id @default(cuid())
  targetUserId   String
  targetUser     User     @relation("AdminNoteTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  authorAdminId  String
  note           String   @db.VarChar(2000)
  isInternal     Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([targetUserId])
}

model FraudFlag {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  reason       String
  severity     FraudSeverity   @default(low)
  status       FraudFlagStatus @default(open)
  reviewedAt   DateTime?
  actionTaken  String?
  createdAt    DateTime        @default(now())

  @@index([userId, status])
  @@index([severity, status])
}

// AML: sanctioned entities list â€” checked on KYC and withdrawals
model SanctionedEntity {
  id          String   @id @default(cuid())
  nameHash    String   @unique
  listSource  String
  addedAt     DateTime @default(now())
  notes       String?

  @@index([nameHash])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// TRUST & STATS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TradeStats {
  id               String      @id @default(cuid())
  userId           String      @unique
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalTrades      Int         @default(0)
  completedTrades  Int         @default(0)
  cancelledTrades  Int         @default(0)
  completionRate   Decimal     @default(0) @db.Decimal(5, 4)
  avgRating        Decimal     @default(0) @db.Decimal(3, 2)
  totalReviews     Int         @default(0)
  totalVolumePKR   Decimal     @default(0) @db.Decimal(18, 2)
  trustScore       Int         @default(0)
  badge            TraderBadge @default(new)
  badgeLabel       String      @default("New Trader")
  badgeOverride    Boolean     @default(false)
  lastUpdated      DateTime    @updatedAt
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// RATE ALERTS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model RateAlert {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coin        String
  network     String
  direction   RateAlertDirection
  targetRate  Decimal            @db.Decimal(14, 2)
  status      RateAlertStatus    @default(active)
  triggeredAt DateTime?
  createdAt   DateTime           @default(now())

  @@index([userId, status])
  @@index([coin, status])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// GAS FEE SYSTEM (GAS_FEE_SPEC.md Section 7)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model GasFeeOrder {
  id                  String            @id @default(cuid())
  orderRef            String            @unique
  userId              String?
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  merchantApiKeyId    String?
  merchantApiKey      MerchantApiKey?   @relation(fields: [merchantApiKeyId], references: [id], onDelete: SetNull)
  ipAddress           String?
  riskScore           Int?              // 0-100; set by gas.risk.ts on order creation

  chain               GasChain
  tier                GasFeeTier?       // nullable: new custom-amount orders skip fixed tiers
  gasTokenConfigId    String?
  gasTokenConfig      GasTokenConfig?   @relation(fields: [gasTokenConfigId], references: [id], onDelete: SetNull)
  gasAmountNative     Decimal           @db.Decimal(18, 8)
  gasAmountUSD        Decimal           @db.Decimal(10, 4)
  priceAtOrder        Decimal           @db.Decimal(18, 8)

  paymentCoin          String            @default("USDT")
  paymentNetwork       String
  paymentAmount        Decimal           @db.Decimal(10, 4)
  trackingToken        String?           @unique  // guest order privacy token (192-bit hex)
  paymentTxHash        String?           @unique
  paymentSenderAddress String?
  paymentProofUrl      String?
  paymentVerifiedAt    DateTime?
  verifiedAmount       Decimal?          @db.Decimal(10, 4)
  verifiedAsset        String?
  verifiedConfirmations Int?
  pkrPaymentMethod     String?
  pkrAmount            Decimal?          @db.Decimal(12, 2)

  toAddress           String
  fromHotWallet       String?
  deliveryTxHash      String?
  deliveryConfirmed   Boolean           @default(false)

  refundTxHash        String?
  refundAmount        Decimal?          @db.Decimal(10, 4)

  status              GasFeeOrderStatus @default(created)
  failureReason       String?
  retryCount          Int               @default(0)
  expiresAt           DateTime

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveredAt         DateTime?
  refundedAt          DateTime?

  ledgerEntries       GasLedgerEntry[]
  flaggedOrder        GasFlaggedOrder?

  @@index([status, expiresAt])
  @@index([userId])
  @@index([orderRef])
}

model GasHotWallet {
  id                   String    @id @default(cuid())
  chain                GasChain
  address              String
  hdIndex              Int       @default(0)   // BIP44 child index for this wallet
  weight               Int       @default(100) // load-balancing weight; higher = preferred
  isActive             Boolean   @default(true)
  lastBalanceRefreshAt DateTime?
  createdAt            DateTime  @default(now())

  @@unique([chain, hdIndex])
  @@index([chain, isActive])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// GAS CHAIN & TOKEN CONFIGURATION (admin-controlled, no code change to add chains)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model GasChainConfig {
  id             String           @id @default(cuid())
  name           String           // "TRON", "BNB Smart Chain", "Ethereum"
  slug           String           @unique // "TRON", "BSC", "ETH", "BASE", "ARB", "MATIC", "OP", "SOL", "TON", "SUI"
  symbol         String           // "TRX", "BNB", "ETH"
  logoUrl        String?
  category       String           // "tron" | "bnb" | "ethereum" | "solana" | "ton" | "sui"
  networkLabel   String           // "TRC20", "BEP20", "ERC20", "Solana", "TON", "SUI"
  addressType    String           // "TRC20" | "EVM" | "SOL" | "TON" | "SUI" â€” maps to frontend regex
  explorerBase   String?
  backendChainId    String?          // Maps to GasChain enum value. Null = not yet deliverable.
  platformFeeUsdt   Float            @default(0.25) // Default platform fee (USDT) â€” used when token has no override
  alertThresholdUsd Float?           // Auto-alert below this USD wallet balance; null = no alert
  pauseThresholdUsd Float?           // Auto-pause new orders below this USD balance; null = no pause
  defaultMinAmount  Decimal?         @db.Decimal(18, 8) // Default min amount for tokens under this chain
  defaultMaxUsdValue Decimal?        @db.Decimal(10, 4) // Default max USD value for tokens under this chain
  isActive          Boolean          @default(true)
  // Feature readiness state: inactive | testing | beta | stable
  // inactive = hidden from public UI; stable = fully operational
  readinessState    String           @default("inactive")
  displayOrder   Int              @default(0)
  tokens         GasTokenConfig[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model GasTokenConfig {
  id              String         @id @default(cuid())
  chainConfigId   String
  chain           GasChainConfig @relation(fields: [chainConfigId], references: [id], onDelete: Cascade)
  name            String         // "TRX", "BNB", "USDT (TRC20)"
  symbol          String         // "TRX", "BNB", "USDT"
  tokenType       String         // "native" | "token"
  contractAddress String?
  logoUrl         String?
  priceSymbol     String         // "TRX", "BNB", "ETH" â€” Redis rate key for pricing
  platformFeeUsdt Float?         // Override; null = inherit from parent chain default
  minAmount       Decimal?       @db.Decimal(18, 8) // Override; null = inherit from parent chain default
  maxUsdValue     Decimal?       @db.Decimal(10, 4) // Override; null = inherit from parent chain default
  presetAmounts   Json           // number[] e.g. [10, 50, 100, 200]
  isActive        Boolean        @default(true)
  displayOrder    Int            @default(0)
  orders          GasFeeOrder[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([chainConfigId, isActive])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// HD-DERIVED DEPOSIT INFRASTRUCTURE
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// One HD-derived deposit address per user per chain family. EVM family addresses
// are shared across all EVM chains (Eth, BSC, Polygon, Arb, Op, Base). The
// derivation index is a monotonic counter â€” see PlatformConfig key
// `next_evm_derivation_index` for allocation.
model DepositAddress {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  chainFamily      String   // 'EVM' for now; 'TRON' | 'TON' | 'SUI' later
  address          String
  derivationIndex  Int
  createdAt        DateTime @default(now())

  subscriptions    MoralisStreamSubscription[]

  @@unique([userId, chainFamily])
  @@unique([address])
  @@index([chainFamily])
}

// One row per (DepositAddress, chain) tracking Moralis Stream subscription
// state. We create one row per supported EVM chain when a new DepositAddress
// is generated, then a worker walks the rows in status='pending' and POSTs
// the address into each chain's Moralis Stream. Idempotent: the unique
// constraint prevents duplicate enqueueing for the same address/chain.
model MoralisStreamSubscription {
  id                 String          @id @default(cuid())
  depositAddressId   String
  depositAddress     DepositAddress  @relation(fields: [depositAddressId], references: [id], onDelete: Cascade)
  chain              String          // matches ChainConfig.id ('ethereum', 'bsc', â€¦)
  streamId           String?         // null until the operator sets MORALIS_STREAM_ID_<CHAIN>
  status             String          @default("pending") // pending | subscribed | failed | skipped
  attempts           Int             @default(0)
  lastError          String?
  lastAttemptAt      DateTime?
  subscribedAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([depositAddressId, chain])
  @@index([status])
  @@index([chain, status])
}

// Append-only audit trail of every on-chain deposit we've seen. A row exists
// from the moment the deposit-watcher first observes the transaction;
// `creditedAt` flips once confirmations meet the chain threshold and we move
// the funds into the user's internal Wallet balance.
model Deposit {
  id                   String   @id @default(cuid())
  txHash               String
  chain                String   // matches ChainConfig.id (ethereum, bsc, ...)
  asset                String   // ERC20 contract address or 'native'
  symbol               String   // resolved symbol (USDT, USDC, ETH, ...)
  fromAddress          String
  toAddress            String
  amount               Decimal  @db.Decimal(38, 18)
  confirmations        Int      @default(0)
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  walletId             String?
  creditedTransactionId String?
  status               String   @default("detected") // detected | credited | rejected
  rejectionReason      String?
  detectedAt           DateTime @default(now())
  creditedAt           DateTime?

  @@unique([txHash, chain, asset])
  @@index([toAddress])
  @@index([userId])
  @@index([status])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// MERCHANT API KEYS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// API keys for programmatic gas fee access.
// Key format: mpak_{keyId}_{secret}
// Only `keyId` and a bcrypt hash of `secret` are stored.
model MerchantApiKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  keyId       String   @unique  // short unique token embedded in the key for O(1) lookup
  keyHash     String            // bcrypt hash of the secret portion
  keyPrefix   String            // first 14 chars of full key â€” display only
  name        String            // "My App Integration"

  isActive    Boolean  @default(true)
  rateLimit   Int      @default(60)   // max requests per minute
  lastUsedAt  DateTime?

  webhookUrl     String?   // POST target for order status callbacks
  webhookSecret  String?   // HMAC-SHA256 signing secret for callbacks

  createdAt   DateTime @default(now())

  gasOrders       GasFeeOrder[]
  merchantAccount GasMerchantAccount?

  @@index([userId])
  @@index([isActive])
}

model GasCustomRequest {
  id             String                  @id @default(cuid())
  blockchainName String
  token          String
  amount         String?
  purpose        String
  urgency        String                  @default("normal")
  details        String?
  contactEmail   String?
  ipAddress      String?
  status         GasCustomRequestStatus  @default(pending)
  adminNotes     String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status])
  @@index([createdAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// TREASURY WALLET
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// One row per chain-family (TRON / EVM). Treasury lives at HD index 100/101 on
// the same mnemonic as the hot wallet (index 0). Never signs delivery txns.
model GasTreasuryWallet {
  id                   String    @id @default(cuid())
  chain                GasChain  @unique  // representative chain (TRON or ETH for EVM family)
  chainFamily          String    // 'TRON' | 'EVM'
  address              String    @unique
  derivationIndex      Int                // 100 = TRON treasury, 101 = EVM treasury
  isActive             Boolean   @default(true)
  lastBalanceRefreshAt DateTime?
  createdAt            DateTime  @default(now())

  refillRequests       GasRefillRequest[]

  @@index([chainFamily, isActive])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// INTERNAL ACCOUNTING LEDGER
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Append-only. Never update a row â€” write a new corrective entry instead.
model GasLedgerEntry {
  id             String               @id @default(cuid())
  entryType      GasLedgerEntryType
  chain          GasChain
  // nativeAmount: positive = inflow to hot wallet; negative = outflow
  nativeAmount   Decimal              @db.Decimal(28, 10)
  nativeSymbol   String               // "TRX", "BNB", "ETH", etc.
  tokenSymbol    String?              // "USDT" for ERC20 payments; null for native-only entries
  tokenAmount    Decimal?             @db.Decimal(28, 10)
  usdAmount      Decimal              @db.Decimal(18, 6)
  txHash         String?
  fromAddress    String?
  toAddress      String?
  sourceKey      String?              @unique
  relatedOrderId String?
  relatedOrder   GasFeeOrder?         @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedRefillId String?
  relatedRefill  GasRefillRequest?    @relation(fields: [relatedRefillId], references: [id], onDelete: SetNull)
  notes          String?              @db.VarChar(500)
  createdAt      DateTime             @default(now())

  @@index([chain, entryType])
  @@index([txHash])
  @@index([relatedOrderId])
  @@index([relatedRefillId])
  @@index([createdAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// HOT-WALLET REFILL SYSTEM
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Per-chain thresholds that drive auto-refill. One row per GasChain.
model GasRefillThreshold {
  id                  String    @id @default(cuid())
  chain               GasChain  @unique
  // Trigger a refill when hot wallet native balance falls below this amount
  triggerBelowNative  Decimal   @db.Decimal(18, 8)
  // After a refill, target this native balance (what to refill TO)
  refillTargetNative  Decimal   @db.Decimal(18, 8)
  // Max single-transfer size (safety cap on each refill tx)
  maxRefillNative     Decimal   @db.Decimal(18, 8)
  isEnabled           Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([isEnabled])
}

// Lifecycle: pending_approval â†’ approved â†’ executing â†’ completed
//                             â†˜ cancelled
//                                        â†˜ failed (retriable)
model GasRefillRequest {
  id              String                  @id @default(cuid())
  chain           GasChain
  fromWalletId    String
  fromWallet      GasTreasuryWallet       @relation(fields: [fromWalletId], references: [id], onDelete: Restrict)
  fromAddress     String
  toAddress       String                  // hot wallet address
  nativeAmount    Decimal                 @db.Decimal(18, 8)
  nativeSymbol    String
  usdAmount       Decimal                 @db.Decimal(18, 6)
  status          GasRefillRequestStatus  @default(pending_approval)
  // Set when hot-wallet balance that triggered this refill was sampled
  triggerBalance  Decimal?                @db.Decimal(18, 8)

  approvedAt      DateTime?
  approvedBy      String?                 // admin userId
  cancelledAt     DateTime?
  cancelledBy     String?
  executedAt      DateTime?
  completedAt     DateTime?
  txHash          String?
  failureReason   String?                 @db.VarChar(500)
  retryCount      Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  ledgerEntries   GasLedgerEntry[]

  @@index([chain, status])
  @@index([status])
  @@index([createdAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PHASE 4 â€” RECONCILIATION ENGINE
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model GasReconciliationRun {
  id               String   @id @default(cuid())
  ranAt            DateTime @default(now())
  chain            GasChain?
  totalOrders      Int      @default(0)
  ordersChecked    Int      @default(0)
  discrepancyCount Int      @default(0)
  status           String   // running | complete | failed
  notes            String?  @db.VarChar(1000)
  discrepancies    GasReconciliationDiscrepancy[]

  @@index([status])
  @@index([ranAt])
}

model GasReconciliationDiscrepancy {
  id          String   @id @default(cuid())
  runId       String
  run         GasReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  orderId     String?
  type        String   // delivery_tx_not_found | amount_mismatch | payment_not_on_chain | stuck_sending
  description String   @db.VarChar(1000)
  resolvedAt  DateTime?
  resolvedBy  String?
  adminNote   String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  @@index([runId])
  @@index([orderId])
  @@index([type])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PHASE 5 â€” RISK / FRAUD FLAGGING
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model GasFlaggedOrder {
  id          String      @id @default(cuid())
  orderId     String      @unique
  order       GasFeeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reasons     String      // JSON array: ["HIGH_DEST_FREQUENCY", ...]
  riskScore   Int         // 0â€“100
  status      String      @default("pending_review") // pending_review | reviewed_ok | reviewed_blocked
  reviewedBy  String?
  reviewedAt  DateTime?
  adminNote   String?     @db.VarChar(500)
  createdAt   DateTime    @default(now())

  @@index([status])
  @@index([riskScore])
  @@index([createdAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PHASE 6 â€” MERCHANT SETTLEMENT
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model GasMerchantAccount {
  id              String   @id @default(cuid())
  name            String
  apiKeyId        String   @unique
  apiKey          MerchantApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)
  commissionRate  Decimal  @default(0) @db.Decimal(5, 4) // 0.0000â€“1.0000
  settlementCycle String   @default("weekly")            // daily | weekly | monthly
  payoutAddress   String?                                // USDT TRC20 for auto-payout
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  settlements     GasMerchantSettlement[]

  @@index([isActive])
}

model GasMerchantSettlement {
  id               String              @id @default(cuid())
  merchantId       String
  merchant         GasMerchantAccount  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  periodStart      DateTime
  periodEnd        DateTime
  orderCount       Int                 @default(0)
  grossRevenueUsd  Decimal             @db.Decimal(18, 6)
  platformFeeUsd   Decimal             @db.Decimal(18, 6)
  merchantShareUsd Decimal             @db.Decimal(18, 6)
  status           String              @default("pending") // pending | approved | paid
  payoutTxHash     String?
  paidAt           DateTime?
  adminNote        String?             @db.VarChar(500)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([merchantId, status])
  @@index([status])
  @@index([periodStart, periodEnd])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// COMMUNITY TOKEN MARKET (CTM)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model CtmToken {
  id                String            @id @default(cuid())
  slug              String            @unique
  symbol            String
  name              String
  description       String            @db.VarChar(2000)
  logoUrl           String?
  bannerUrl         String?
  settlementType    CtmSettlementType
  network           String?
  contractAddress   String?
  explorerUrl       String?
  officialWebsite   String?
  officialTwitter   String?
  officialTelegram  String?
  whitePaperUrl     String?
  status            CtmTokenStatus    @default(pending_review)
  riskTier          CtmTokenRiskTier  @default(high)
  riskNotes         String?           @db.VarChar(1000)
  riskLabels        String[]          @default([])
  communityVerified Boolean           @default(false)
  verifiedByAdminId String?
  verifiedAt        DateTime?
  isListingEnabled  Boolean           @default(true)
  maxListingAmount  Decimal?          @db.Decimal(28, 8)
  minTradeAmountPkr Decimal?          @db.Decimal(14, 2)
  totalListings     Int               @default(0)
  totalTrades       Int               @default(0)
  totalVolumePkr    Decimal           @default(0) @db.Decimal(18, 2)
  lastTradedAt      DateTime?
  suggestedByUserId String?
  addedByAdminId    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  listings          CtmListing[]
  requests          CtmRequest[]
  tokenRequests     CtmTokenRequest[]
  trades            CtmTrade[]

  @@index([status, isListingEnabled])
  @@index([settlementType])
  @@index([slug])
}

model CtmTokenRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenId         String?
  token           CtmToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  tokenName       String
  tokenSymbol     String
  description     String    @db.VarChar(1000)
  officialWebsite String?
  evidenceUrl     String?
  status          String    @default("pending")
  adminNote       String?   @db.VarChar(500)
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

model CtmMerchantProfile {
  id                     String          @id @default(cuid())
  userId                 String          @unique
  user                   User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  merchantId             String          @unique
  merchant               Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  tier                   CtmMerchantTier @default(new)
  collateralAmount       Decimal         @default(0) @db.Decimal(18, 8)
  collateralCoin         String          @default("USDT")
  totalCtmTrades         Int             @default(0)
  completedCtmTrades     Int             @default(0)
  disputedCtmTrades      Int             @default(0)
  ctmDisputeRate         Decimal         @default(0) @db.Decimal(6, 4)
  ctmAvgRating           Decimal         @default(0) @db.Decimal(3, 2)
  settlementInstructions Json            @default("{}")
  isActive               Boolean         @default(true)
  suspendedUntil         DateTime?
  suspendReason          String?
  approvedAt             DateTime?
  approvedBy             String?
  lastActiveAt           DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  listings               CtmListing[]

  @@index([tier, isActive])
  @@index([userId])
}

model CtmListing {
  id                String             @id @default(cuid())
  listingRef        String             @unique @default(cuid())
  merchantProfileId String
  merchantProfile   CtmMerchantProfile @relation(fields: [merchantProfileId], references: [id], onDelete: Restrict)
  tokenId           String
  token             CtmToken           @relation(fields: [tokenId], references: [id], onDelete: Restrict)
  side              AdSide
  settlementType    CtmSettlementType
  priceType         PriceType          @default(fixed)
  pricePerUnit      Decimal            @db.Decimal(14, 2)
  totalAmount       Decimal            @db.Decimal(28, 8)
  availableAmount   Decimal            @db.Decimal(28, 8)
  lockedAmount      Decimal            @default(0) @db.Decimal(28, 8)
  minOrderPkr       Decimal?           @db.Decimal(14, 2)
  maxOrderPkr       Decimal?           @db.Decimal(14, 2)
  minOrderTokens    Decimal            @db.Decimal(28, 8)
  maxOrderTokens    Decimal            @db.Decimal(28, 8)
  settlementMethod  String             @db.VarChar(100)
  tokenDeliveryType String?            @db.VarChar(20)
  settlementNote    String             @db.VarChar(1000)
  paymentMethods    String[]
  tradeWindowMins   Int                @default(45)
  terms             String             @default("") @db.VarChar(2000)
  status            CtmListingStatus   @default(active)
  requiresProof     Boolean            @default(true)
  proofInstructions String?            @db.VarChar(500)
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  trades            CtmTrade[]
  listingBids       CtmListingBid[]

  @@index([tokenId, side, status])
  @@index([merchantProfileId])
}

model CtmRequest {
  id             String           @id @default(cuid())
  requestRef     String           @unique @default(cuid())
  userId         String
  user           User             @relation("CtmRequestUser", fields: [userId], references: [id], onDelete: Restrict)
  tokenId        String
  token          CtmToken         @relation(fields: [tokenId], references: [id], onDelete: Restrict)
  side           AdSide
  amount         Decimal          @db.Decimal(28, 8)
  targetPricePkr Decimal?         @db.Decimal(14, 2)
  paymentMethods String[]
  note           String?          @db.VarChar(500)
  status         CtmRequestStatus @default(open)
  expiresAt      DateTime
  acceptedBidId  String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  bids           CtmBid[]
  trade          CtmTrade?        @relation("CtmRequestTrade")

  @@index([tokenId, side, status])
  @@index([userId])
}

model CtmBid {
  id           String     @id @default(cuid())
  requestId    String
  request      CtmRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  bidderId     String
  bidder       User       @relation("CtmBidder", fields: [bidderId], references: [id], onDelete: Restrict)
  pricePerUnit Decimal    @db.Decimal(14, 2)
  totalPkr     Decimal    @db.Decimal(14, 2)
  message      String?    @db.VarChar(300)
  status       String     @default("pending")
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([requestId, status])
  @@index([bidderId])
}

model CtmTrade {
  id                String            @id @default(cuid())
  tradeRef          String            @unique @default(cuid())
  listingId         String?
  listing           CtmListing?       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  requestId         String?           @unique
  request           CtmRequest?       @relation("CtmRequestTrade", fields: [requestId], references: [id], onDelete: Restrict)
  buyerId           String
  buyer             User              @relation("CtmTradeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId          String
  seller            User              @relation("CtmTradeSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  tokenId           String
  token             CtmToken          @relation(fields: [tokenId], references: [id])
  settlementType    CtmSettlementType
  tokenAmount       Decimal           @db.Decimal(28, 8)
  pricePerUnit      Decimal           @db.Decimal(14, 2)
  fiatAmount        Decimal           @db.Decimal(14, 2)
  paymentMethod          String
  paymentProofUrl        String?
  paymentProofHash       String?
  settlementMethod       String            @db.VarChar(100)
  buyerSettlementId      String?           @db.VarChar(500)
  sellerPaymentSnapshot  Json?
  buyerPaymentSnapshot   Json?
  status            CtmTradeStatus    @default(awaiting_payment)
  proofDeadlineAt   DateTime?
  confirmDeadlineAt DateTime?
  expiresAt         DateTime
  cancelledBy       String?
  cancelReason      String?
  cancelledAt       DateTime?
  completedAt       DateTime?
  escrowAddress     String?           @db.VarChar(200)
  escrowAmount      Decimal?          @db.Decimal(28, 8)
  escrowCurrency    String?           @db.VarChar(20)
  escrowTxHash      String?           @db.VarChar(200)
  escrowConfirmedAt DateTime?
  platformFeePkr    Decimal?          @db.Decimal(14, 4)
  platformFeeUsdt   Decimal?          @db.Decimal(14, 6)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  listingBidId      String?           @unique
  listingBid        CtmListingBid?    @relation(fields: [listingBidId], references: [id], onDelete: SetNull)
  proofs            CtmTradeProof[]
  messages          CtmTradeMessage[]
  dispute           CtmDispute?
  ratings           CtmTradeRating[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([tradeRef])
  @@index([tokenId, status])
}

model CtmListingBid {
  id                   String      @id @default(cuid())
  listingId            String
  listing              CtmListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderId             String
  bidder               User        @relation("CtmListingBidder", fields: [bidderId], references: [id], onDelete: Restrict)
  pricePerUnit         Decimal     @db.Decimal(14, 2)
  tokenAmount          Decimal     @db.Decimal(28, 8)
  fiatAmount           Decimal     @db.Decimal(14, 2)
  message              String?     @db.VarChar(300)
  paymentMethod        String?     @db.VarChar(100)
  paymentMethods       String[]
  buyerSettlementId    String?     @db.VarChar(500)
  buyerPaymentMethodId String?     @db.VarChar(100)
  status               String      @default("pending")
  expiresAt            DateTime
  trade                CtmTrade?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([listingId, status])
  @@index([bidderId])
}

model CtmTradeProof {
  id              String       @id @default(cuid())
  tradeId         String
  trade           CtmTrade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  uploadedBy      String
  proofType       CtmProofType
  fileUrl         String?
  fileHash        String?
  txHash          String?
  description     String?      @db.VarChar(500)
  isAdminReviewed Boolean      @default(false)
  adminNote       String?      @db.VarChar(500)
  createdAt       DateTime     @default(now())

  @@index([tradeId])
}

model CtmTradeMessage {
  id            String   @id @default(cuid())
  tradeId       String
  trade         CtmTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  senderId      String
  message       String   @db.VarChar(1000)
  attachmentUrl String?
  createdAt     DateTime @default(now())

  @@index([tradeId])
}

model CtmDispute {
  id                    String                 @id @default(cuid())
  tradeId               String                 @unique
  trade                 CtmTrade               @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  openedById            String
  reason                CtmDisputeReason
  description           String                 @db.VarChar(5000)
  status                DisputeStatus          @default(open)
  resolution            String?                @db.VarChar(2000)
  winner                DisputeWinner?
  resolutionType        DisputeResolutionType?
  flaggedForTokenReview Boolean                @default(false)
  escalatedAt           DateTime?
  resolvedAt            DateTime?
  resolvedBy            String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  messages              CtmDisputeMessage[]

  @@index([status])
}

model CtmDisputeMessage {
  id          String     @id @default(cuid())
  disputeId   String
  dispute     CtmDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId    String
  message     String     @db.VarChar(2000)
  evidenceUrl String?
  createdAt   DateTime   @default(now())

  @@index([disputeId])
}

model CtmTradeRating {
  id            String   @id @default(cuid())
  tradeId       String
  trade         CtmTrade @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  ratedByUserId String
  ratedUserId   String
  rating        Int
  comment       String?  @db.VarChar(500)
  tags          String[]
  createdAt     DateTime @default(now())

  @@unique([tradeId, ratedByUserId])
  @@index([ratedUserId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// DEPOSIT CHAIN REGISTRY
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model DepositChain {
  id               String         @id @default(cuid())
  slug             String         @unique
  chainId          Int?
  name             String
  family           String
  nativeSymbol     String
  networkLabel     String         @unique
  minConfirmations Int
  explorerBase     String
  rpcEnvVar        String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tokens           DepositToken[]

  @@index([family])
}

model DepositToken {
  id                  String       @id @default(cuid())
  chainId             String
  chain               DepositChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  symbol              String
  address             String?
  decimals            Int
  isActive            Boolean      @default(true)
  coingeckoId         String?
  trustWalletVerified Boolean      @default(false)
  onChainVerified     Boolean      @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([chainId, symbol])
  @@index([symbol])
}

// ─────────────────────────────────────────────────────────────────────────────
// GLOBAL LOGO REGISTRY
// Stores admin-uploaded logos for any entity type that doesn't have its own
// logoUrl field (payment methods, banks, wallet providers, etc.).
// Chains and tokens upload directly to GasChainConfig / GasTokenConfig / CtmToken;
// this table covers everything else and acts as an override layer for all types.
// ─────────────────────────────────────────────────────────────────────────────

model LogoRegistry {
  id        String   @id @default(cuid())
  // "chain" | "token" | "payment_method" | "bank" | "wallet_provider"
  type      String
  // Normalized slug: uppercase for chain/token (e.g. "BSC", "USDT"),
  // lowercase for payment_method/bank/wallet_provider (e.g. "jazzcash", "hbl")
  slug      String
  logoUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, slug])
  @@index([type])
}


