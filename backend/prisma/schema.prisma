// CORE MODELS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  fullName      String
  username      String    @unique
  passwordHash  String
  googleId      String?   @unique

  // ── Telegram Mini App identity ──
  // telegramId is the numeric Telegram user id (stored as BigInt — ids exceed
  // 2^31). Present only for accounts created/linked via the Mini App. Telegram's
  // HMAC-validated initData proves this identity, so these accounts skip the
  // email-verification gate.
  telegramId        BigInt?   @unique
  telegramUsername  String?
  telegramPhotoUrl  String?
  telegramAuthAt    DateTime?
  // Set when the bot gets a 403 from this user (blocked the bot, or never
  // /start-ed it so we "can't initiate conversation"). While non-null we send
  // them NO bot messages — continuing to DM blocked users is the #1 Telegram
  // ban trigger. Cleared automatically when they next /start the bot.
  telegramBlockedAt DateTime?

  role          UserRole  @default(user)
  intendedRole  String    @default("user")

  kycStatus     KycStatus @default(none)
  kycLevel      KycLevel  @default(none)

  referralCode  String    @unique @default(cuid())
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]    @relation("Referrals")

  twoFaEnabled  Boolean   @default(false)
  twoFaSecret   String?

  avatarUrl         String?
  usernameChangedAt DateTime?

  // Set when KYC approval locks fullName to the CNIC legal name. While non-null,
  // the user can no longer self-edit their display name (admin override only).
  // Canonical identity for non-custodial P2P trust.
  legalNameLockedAt DateTime?

  // Withdrawal security lock â€” set after password/email/2FA changes.
  // requestWithdrawal checks this before creating any withdrawal.
  withdrawalLockedUntil DateTime?
  withdrawalLockReason  String?   @db.VarChar(200)

  isEmailVerified        Boolean @default(false)
  isSuspended            Boolean @default(false)
  isBanned               Boolean @default(false)
  suspendReason          String?

  // ── Moderation framework (Admin Audit Phase 1) ──
  // isBanned/isSuspended remain the authoritative enforcement flags (read by
  // auth middleware + login). The fields below add duration + classification.
  suspendedUntil         DateTime?          // when a suspension auto-lifts (null = until manually lifted)
  bannedUntil            DateTime?          // when a TEMPORARY ban auto-lifts (null + isBanned = permanent)
  banType                String?            // "temporary" | "permanent" (set when isBanned)
  underReview            Boolean  @default(false)  // flagged for review; informational, does not block access
  moderationReason       String?  @db.VarChar(1000) // current active reason (ban or suspend)

  dailyBuyUsed           Decimal @default(0) @db.Decimal(14, 2)
  dailyBuyReset          DateTime?
  monthlyBuyUsed         Decimal @default(0) @db.Decimal(14, 2)
  monthlyBuyReset        DateTime?
  dailyBuyLimit          Decimal @default(50000) @db.Decimal(14, 2)
  dailySellLimit         Decimal @default(50000) @db.Decimal(14, 2)

  // Non-custodial anti-griefing: incremented when the user abandons a trade
  // (auto-cancelled for non-payment); tradeCooldownUntil blocks starting a new
  // trade until it elapses. Only enforced when noncustodial_p2p_enabled is ON.
  tradeAbandonCount      Int       @default(0)
  tradeCooldownUntil     DateTime?

  completedSellTrades    Int     @default(0)
  firstTradeBonusPaid    Boolean @default(false)
  marketingEmailsEnabled Boolean @default(true)
  // Broadcast announcements (admin-curated product/feature/gas updates). Default
  // ON; users may mute in Settings. Independent of transactional notifications —
  // muting this NEVER suppresses trade/money/security alerts.
  announcementsEnabled   Boolean @default(true)

  socialLinks            Json    @default("{}")
  socialLinksPublic      Boolean @default(false)

  termsAcceptedAt        DateTime?
  termsVersion           String?

  registrationIp         String?
  country                String?                    // geo-IP country name (from registrationIp)
  countryCode            String?                    // ISO 3166-1 alpha-2 (e.g. "PK")

  lastSeenAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations â€” onDelete rules are explicit (no implicit RESTRICT surprises)
  wallets                Wallet[]
  trades                 Trade[]             @relation("TradeBuyer")
  sellTrades             Trade[]             @relation("TradeSeller")
  ads                    Ad[]
  instantBuyOrders       InstantBuyOrder[]
  kycSubmissions         KycSubmission[]
  paymentMethods         PaymentMethod[]
  savedAddresses         SavedAddress[]
  withdrawals            Withdrawal[]
  collateralLocks        CollateralLock[]
  referralRewardsGiven   ReferralReward[]    @relation("ReferralRewardsGiven")
  referralRewardsEarned  ReferralReward[]    @relation("ReferralRewardsEarned")
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  sessions               Session[]
  tradeStats             TradeStats?
  merchant               Merchant?
  fraudFlags             FraudFlag[]
  rateAlerts             RateAlert[]
  savedTerms             SavedTerms[]
  adminNotes             AdminNote[]         @relation("AdminNoteTarget")
  moderationActions      ModerationAction[]  @relation("ModerationActionTarget")
  moderatorActions       ModerationAction[]  @relation("ModerationActionModerator")
  appeals                Appeal[]            @relation("AppealUser")
  appealsReviewed        Appeal[]            @relation("AppealReviewer")
  auditLogs              AuditLog[]
  gasFeeOrders           GasFeeOrder[]
  merchantApiKeys        MerchantApiKey[]
  depositAddresses       DepositAddress[]
  deposits               Deposit[]
  bondHolds              BondHold[]                 @relation("BondHoldMaker")
  trustedAddresses       TrustedWithdrawalAddress[]
  trustedDevices         TrustedDevice[]
  ctmTokenRequests       CtmTokenRequest[]
  ctmMerchantProfile     CtmMerchantProfile?
  ctmBuyTrades           CtmTrade[]            @relation("CtmTradeBuyer")
  ctmSellTrades          CtmTrade[]            @relation("CtmTradeSeller")
  ctmRequests            CtmRequest[]          @relation("CtmRequestUser")
  ctmBids                CtmBid[]              @relation("CtmBidder")
  ctmListingBids         CtmListingBid[]       @relation("CtmListingBidder")
  adBids                 AdBid[]               @relation("AdBidder")
  favorites              UserFavorite[]         @relation("FavoritingUser")
  favoritedBy            UserFavorite[]         @relation("FavoritedTrader")
  supportConversations   SupportConversation[]
  announcementsSent      Announcement[]          @relation("AnnouncementsSent")
  announcementDismissals AnnouncementDismissal[]
  gasReferralCodes       GasReferralCode[]       @relation("GasRefCodeOwner")
  gasReferralAsReferred  GasReferral?            @relation("GasReferredUser")
  gasReferralsAsReferrer GasReferral[]           @relation("GasReferrerUser")
  gasReferralAccruals    GasReferralAccrual[]    @relation("GasReferrerAccrual")
  gasAffiliate           GasAffiliate?           @relation("GasAffiliateUser")
  tradeStreaksAsA        TradeStreak[]           @relation("StreakUserA")
  tradeStreaksAsB        TradeStreak[]           @relation("StreakUserB")
  chatThreadsAsA         ChatThread[]            @relation("ChatThreadUserA")
  chatThreadsAsB         ChatThread[]            @relation("ChatThreadUserB")

  @@index([email])
  @@index([username])
  @@index([referralCode])
}

model Wallet {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  coin           String
  network        String
  balance        Decimal  @default(0) @db.Decimal(18, 8)
  lockedBalance  Decimal  @default(0) @db.Decimal(18, 8)
  depositAddress String?

  transactions   Transaction[]

  @@unique([userId, coin, network], name: "userId_coin_network")
  @@index([userId])
}

model Transaction {
  id        String          @id @default(cuid())
  walletId  String
  wallet    Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type      TransactionType
  amount    Decimal         @db.Decimal(18, 8)
  fee       Decimal         @default(0) @db.Decimal(18, 8)
  txHash    String?
  status    String          @default("completed")
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now())

  @@index([walletId])
  @@index([txHash])
}

// Withdrawal â€” tiered risk-based approval flow
// Tier 1 (<$200, no flags): auto_approved â†’ mark-sent directly
// Tier 2 ($200â€“$500, or tier 1 with risk flags): pending â†’ 1 admin â†’ approved
// Tier 3 ($500â€“$2000): pending â†’ first_approved â†’ approved (2 admins)
// Tier 4 (>$2000): on_hold â†’ admin reviews â†’ pending â†’ tier 3 flow
model Withdrawal {
  id               String           @id @default(cuid())
  orderRef         String           @unique
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  coin             String
  network          String
  amount           Decimal          @db.Decimal(18, 8)
  fee              Decimal          @default(0) @db.Decimal(18, 8)
  toAddress        String
  status           WithdrawalStatus @default(pending)
  tier             Int              @default(3)
  riskScore        Int              @default(0)
  riskFlags        String[]         @default([])
  amountUsd        Decimal?         @db.Decimal(18, 2)
  txHash           String?
  firstApprovedBy  String?
  secondApprovedBy String?
  rejectedBy       String?
  rejectionReason  String?          @db.VarChar(500)
  adminNote        String?          @db.VarChar(500)
  onHoldBy         String?
  onHoldReason     String?          @db.VarChar(500)
  riskOverride     Boolean          @default(false)
  riskOverrideBy   String?
  riskOverrideNote String?          @db.VarChar(500)
  // Email confirmation channel support â€” extensible to 'telegram' later
  confirmationChannel  String   @default("email")
  confirmationSentAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  completedAt      DateTime?

  @@index([userId, status])
  @@index([status])
  @@index([orderRef])
}

// Single-row config for withdrawal tier thresholds and risk rules.
// id is always 1; use upsert to create or update.
model WithdrawalTierConfig {
  id                    Int      @id @default(1)
  tier1MaxUsd           Decimal  @default(200)  @db.Decimal(10, 2)
  tier2MaxUsd           Decimal  @default(500)  @db.Decimal(10, 2)
  tier3MaxUsd           Decimal  @default(2000) @db.Decimal(10, 2)
  autoApproveEnabled    Boolean  @default(true)
  firstWithdrawalReview Boolean  @default(true)
  newWalletReview       Boolean  @default(true)
  velocityWindowMins    Int      @default(60)
  velocityMaxCount      Int      @default(3)
  // JSON map of coin â†’ USD price used to bucket withdrawals into tiers.
  // Example: {"USDT":1,"BNB":600,"ETH":3000,"BTC":60000}
  coinPricesUsd         Json     @default("{\"USDT\":1,\"USDC\":1,\"BNB\":600,\"ETH\":3000,\"BTC\":60000}")
  // Phase 1 / Phase 3 security knobs
  emailConfirmationEnabled  Boolean @default(true)
  emailConfirmationTtlMins  Int     @default(15)   // how long the confirm link is valid
  addressActivationHours    Int     @default(24)   // delay before a new trusted address is usable
  updatedAt             DateTime @updatedAt
  updatedBy             String?
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// P2P TRADING
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Ad {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  side            AdSide
  coin            String
  network         String
  // Multi-network support: a wallet-delivery ad may offer more than one on-chain
  // network (e.g. BEP20 + Aptos). `network` stays as the primary/first network for
  // back-compat; `networks` holds the full set. Empty = legacy ad → treat as [network].
  networks        String[]  @default([])
  priceType       PriceType @default(fixed)
  price           Decimal   @db.Decimal(14, 2)
  floatOffset     Decimal   @default(0) @db.Decimal(6, 4)
  totalAmount     Decimal   @db.Decimal(18, 8)
  availableAmount Decimal   @db.Decimal(18, 8)
  lockedAmount    Decimal   @default(0) @db.Decimal(18, 8)
  minOrder        Decimal   @db.Decimal(14, 2)
  maxOrder        Decimal   @db.Decimal(14, 2)
  paymentMethods     String[]
  tokenDeliveryTypes String[]
  settlementMethod   String?   @db.VarChar(500)
  // Multi-method receiving (BUY ads): one destination per offered network/exchange,
  // e.g. [{ method:'wallet_blockchain', network:'BEP20', address:'0x…' },
  //       { method:'binance', network:null, address:'12345678' }]. `settlementMethod`
  // stays as the primary (first) destination's address for back-compat. Empty/null =
  // legacy single-destination ad → use settlementMethod.
  settlementDestinations Json?
  tradeWindow       Int       @default(30)
  terms             String    @default("") @db.VarChar(2000)
  status            AdStatus  @default(active)
  lastPriceUpdate DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trades          Trade[]
  bids            AdBid[]

  @@index([side, coin, status])
  @@index([userId])
}

model Trade {
  id                 String      @id @default(cuid())
  orderRef           String      @unique
  adId               String
  ad                 Ad          @relation(fields: [adId], references: [id], onDelete: Restrict)
  buyerId            String
  buyer              User        @relation("TradeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId           String
  seller             User        @relation("TradeSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  coin               String
  network            String
  amount             Decimal     @db.Decimal(18, 8)
  price              Decimal     @db.Decimal(14, 2)
  fiatAmount         Decimal     @db.Decimal(14, 2)
  paymentMethod        String
  status               TradeStatus @default(payment_pending)
  // Dispute-resume: an open dispute parks `status` at `disputed` (so every admin
  // list/filter/dashboard keeps working unchanged) while THIS column carries the
  // real ladder rung, letting both parties keep settling. It ADVANCES as they act.
  // The dispute closes itself as `settled_by_parties` only when the trade actually
  // COMPLETES — never when the accused merely acts. NULL when not disputed.
  disputeResumeStatus  TradeStatus?
  paymentProofUrl      String?
  buyerWalletAddress   String      @default("")
  buyerDeliveryMethod  String?     // 'blockchain' | 'email' | 'username' | 'internal'
  buyerDeliveryAddress String?     // the receiving address / email / username
  sellerTxHash         String?   @unique
  sellerDeliveryProofUrl String? // optional screenshot of the crypto transfer (manual/exchange-UID delivery, or supplemental proof alongside a tx hash)
  txVerificationStatus String?   // verified | failed | mismatch_receiver | mismatch_amount | reverted | not_found | rpc_error | pending | skipped
  txVerificationDetails Json?    // { chain, rpcChecked, txStatus, expectedReceiver, actualReceiver, expectedAmount, actualAmount, confirmations, tokenContract, verifiedAt }
  sellerPaymentSnapshot Json?    // { type, label, accountName, mobileNumber?, bankName?, ibanNumber?, accountNumber? } — locked at trade creation so the buyer's pay-to account is immutable for disputes
  buyerPaymentSnapshot  Json?    // buy ads only: the buyer/lister's pay-FROM account(s) declared at ad creation, so the seller sees where PKR will arrive from. Single account or { accounts: [...] }.
  escrowReleased     Boolean     @default(false)
  // Taker-first settlement (Phase 1): true when this trade uses the reordered
  // BUY-ad flow (taker sends crypto first, merchant pays second). Stamped at
  // creation from isTakerFirstForMarket('usdt'); false = classic fiat-first flow.
  takerFirst         Boolean     @default(false)
  cancelledBy        String?
  cancelReason       String?
  cancelledAt        DateTime?
  expiresAt          DateTime
  paymentUploadedAt  DateTime?   // set when buyer uploads payment proof
  paymentConfirmedAt DateTime?   // set when seller confirms payment received
  releasedAt         DateTime?   // set when trade completes (crypto_released) — anchor for the rating window
  // Non-custodial release window: when the seller confirms payment, they must
  // release within this deadline or the trade auto-escalates to a dispute.
  // Only set when noncustodial_p2p_enabled is ON.
  releaseDeadlineAt  DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  adBidId            String?     @unique
  adBid              AdBid?      @relation(fields: [adBidId], references: [id], onDelete: SetNull)

  messages           TradeMessage[]
  dispute            Dispute?
  ratings            TradeRating[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([orderRef])
  @@index([adId])
  @@index([status, expiresAt])
}

model AdBid {
  id               String   @id @default(cuid())
  adId             String
  ad               Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  bidderId         String
  bidder           User     @relation("AdBidder", fields: [bidderId], references: [id], onDelete: Restrict)
  pricePerUnit     Decimal  @db.Decimal(14, 2)
  usdtAmount       Decimal  @db.Decimal(18, 8)
  fiatAmount       Decimal  @db.Decimal(14, 2)
  message          String?  @db.VarChar(300)
  paymentMethod    String?
  buyerUsdtAddress String?  @db.VarChar(300)
  status           String   @default("pending")
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  trade            Trade?

  @@index([adId, status])
  @@index([bidderId])
}

model TradeMessage {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  senderId      String
  message       String   @db.VarChar(500)
  attachmentUrl String?
  // System (auto) messages posted by the platform on each step transition. Rendered
  // as centered status lines in chat rather than as a party's bubble.
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([tradeId])
}

model Dispute {
  id             String                @id @default(cuid())
  tradeId        String                @unique
  trade          Trade                 @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  openedById     String
  reason         String
  description    String                @db.VarChar(5000)
  status         DisputeStatus         @default(open)
  resolution     String?               @db.VarChar(2000)
  winner         DisputeWinner?
  resolutionType DisputeResolutionType?
  escalatedAt    DateTime?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  messages       DisputeMessage[]

  @@index([status])
}

model DisputeMessage {
  id          String   @id @default(cuid())
  disputeId   String
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId    String
  message     String   @db.VarChar(2000)
  evidenceUrl String?
  createdAt   DateTime @default(now())

  @@index([disputeId])
}

model TradeRating {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade    @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  ratedByUserId String
  ratedUserId   String
  rating        Int
  comment       String?  @db.VarChar(500)
  tags          String[]
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([tradeId, ratedByUserId])
  @@index([ratedUserId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// INSTANT BUY (OTC)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model InstantBuyOrder {
  id                   String             @id @default(cuid())
  orderRef             String             @unique
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  coin                 String
  network              String
  paymentMode          PaymentMode
  fiatAmount           Decimal?           @db.Decimal(14, 2)
  coinAmount           Decimal            @db.Decimal(18, 8)
  rate                 Decimal            @db.Decimal(14, 2)
  fee                  Decimal            @db.Decimal(14, 4)
  status               InstantBuyStatus   @default(payment_pending)
  verificationStatus   VerificationStatus @default(pending_layer1)
  paymentProofUrl      String?
  paymentProofHash     String?
  incomingTxHash       String?
  toAddress            String
  quoteExpiresAt       DateTime
  rejectionReason      String?            @db.VarChar(500)
  ocrConfidence        Int?
  ocrExtractedAmount   Decimal?           @db.Decimal(14, 2)
  resubmitCount        Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, status])
  @@index([orderRef])
  @@index([paymentProofHash])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// KYC
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model KycSubmission {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          KycStatus         @default(pending)
  tier            KycSubmissionTier @default(basic)
  frontUrl        String
  backUrl         String
  selfieUrl       String
  videoUrl        String?
  cnicNumberHash  String
  // Legal name exactly as printed on the CNIC, typed by the applicant so the
  // reviewer can compare it against the card image. On approval this becomes the
  // user's canonical, locked name (User.legalNameLockedAt). Non-custodial P2P.
  legalName       String?
  socialLinks     Json              @default("[]")
  rejectionReason String?           @db.VarChar(500)
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime          @default(now())

  @@index([userId])
  @@index([cnicNumberHash])
}

model MerchantKycSubmission {
  id                  String            @id @default(cuid())
  userId              String
  businessName        String
  businessDescription String            @db.VarChar(1000)
  contactPhone        String
  businessProofType   BusinessProofType
  cnicFrontUrl        String
  cnicBackUrl         String
  selfieUrl           String
  businessProofUrl    String
  socialLinks         Json              @default("[]")
  status              KycStatus         @default(pending)
  rejectionReason     String?           @db.VarChar(500)
  reviewedAt          DateTime?
  reviewedBy          String?
  createdAt           DateTime          @default(now())

  @@index([userId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PAYMENTS & WALLET
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model PaymentMethod {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          PaymentMethodType
  displayName   String
  accountName   String
  mobileNumber  String?
  bankName      String?
  ibanNumber    String?
  accountNumber String?
  isActive      Boolean           @default(true)
  // User-hidden (reversible) — excluded from listing/trade pickers and from the
  // resolved payment methods shown on existing ads, but still visible in Wallet
  // management so it can be un-hidden. Distinct from isActive=false (removed).
  hidden        Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@index([userId])
}

model SavedAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coin      String
  network   String
  address   String
  label     String
  // User-hidden (reversible) — excluded from trade delivery/tap-to-fill pickers
  // but still visible in Wallet management so it can be un-hidden.
  hidden    Boolean  @default(false)

  @@unique([userId, coin, network, address])
  @@index([userId])
}

// Trusted withdrawal addresses â€” addresses a user has explicitly whitelisted.
// Newly-added addresses have a 24h activation delay before they can be used.
// Withdrawals to non-whitelisted addresses raise the NEW_WALLET risk flag.
model TrustedWithdrawalAddress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coin        String
  network     String
  address     String
  label       String   @db.VarChar(100)
  activatesAt DateTime                    // addedAt + activationHours
  addedAt     DateTime @default(now())
  lastUsedAt  DateTime?
  removedAt   DateTime?                   // soft-delete

  @@unique([userId, coin, network, address])
  @@index([userId])
  @@index([userId, removedAt])
}

// Trusted devices — once a user clears 2FA on a device and opts to trust it, a
// hashed device-trust token is stored here so future logins from the SAME device
// skip the login TOTP step (until expiry, or a security event revokes it).
// This ONLY shortcuts the login-time code; step-up 2FA for withdrawals / admin
// money-moves is unaffected.
model TrustedDevice {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique          // sha256 of the random cookie token
  fingerprint String                     // sha256 of the user-agent (device binding)
  label       String?   @db.VarChar(200) // human-readable UA summary for the device list
  ip          String?                    // IP at enrolment
  lastIp      String?                    // IP at most recent use
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId])
  @@index([tokenHash])
}

model CollateralLock {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  coin        String           @default("USDT")
  amount      Decimal          @db.Decimal(18, 8)
  status      CollateralStatus @default(locked)
  lockedAt    DateTime         @default(now())
  unlockedAt  DateTime?
  seizedAt    DateTime?
  seizeReason String?

  @@index([userId, status])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// MERCHANT
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Merchant {
  id                  String         @id @default(cuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessName        String
  status              MerchantStatus @default(pending)
  spreadBps           Int            @default(0)
  approvedAt          DateTime?
  rank                MerchantRank   @default(bronze)
  rankUpdatedAt       DateTime?
  disputeRate         Decimal        @default(0) @db.Decimal(6, 4)
  socialLinks         Json           @default("{}")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  inventory           MerchantInventory[]
  ctmProfile          CtmMerchantProfile?
}

model MerchantInventory {
  id              String   @id @default(cuid())
  merchantId      String
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  coin            String
  network         String
  availableAmount Decimal  @db.Decimal(18, 8)
  pricePerUnit    Decimal  @db.Decimal(14, 2)
  updatedAt       DateTime @updatedAt

  @@index([merchantId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// REFERRAL
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ReferralReward {
  id           String               @id @default(cuid())
  referrerId   String
  referrer     User                 @relation("ReferralRewardsGiven", fields: [referrerId], references: [id], onDelete: Restrict)
  referredId   String
  referred     User                 @relation("ReferralRewardsEarned", fields: [referredId], references: [id], onDelete: Restrict)
  status       ReferralRewardStatus @default(pending)
  rewardAmount Decimal              @db.Decimal(14, 2)
  paidAt       DateTime?
  createdAt    DateTime             @default(now())

  @@index([referrerId, status])
}

// Pending referral attribution captured at bot `/start ref_<code>` time, BEFORE
// any account exists. Keyed by the Telegram user id. /api/v1/miniapp/auth reads
// (and clears) this when auto-creating a new user, so a Telegram deep-link signup
// credits the referrer even though no account row existed at /start.
model TelegramPendingReferral {
  telegramId   BigInt   @id
  referralCode String
  createdAt    DateTime @default(now())
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// NOTIFICATIONS & COMMS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  metadata  Json     @default("{}")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ── BROADCAST ANNOUNCEMENTS ────────────────────────────────────────────────
// Admin-composed announcements fanned out to all users across up to three
// channels: a dismissible website banner ("web"), the in-app bell ("bell"),
// and the Telegram bot ("telegram"). Deliberately admin-triggered — NOT an
// automatic per-event firehose — so it stays a low-frequency, high-signal lane.
model Announcement {
  id             String   @id @default(cuid())
  title          String
  body           String
  // Optional call-to-action link (internal path like /gas, or absolute URL).
  linkUrl        String?
  // Subset of: "web" | "bell" | "telegram" — chosen per announcement by admin.
  channels       String[]
  // Controls the website banner only. Admin can retire a banner without
  // affecting bell/telegram copies already delivered.
  isActive       Boolean  @default(true)
  sentByAdminId  String?
  sentByAdmin    User?    @relation("AnnouncementsSent", fields: [sentByAdminId], references: [id], onDelete: SetNull)
  // Delivery telemetry, stamped by the broadcast job.
  bellRecipients Int      @default(0)
  telegramSent   Int      @default(0)
  telegramFailed Int      @default(0)
  createdAt      DateTime @default(now())

  dismissals     AnnouncementDismissal[]

  @@index([isActive, createdAt])
}

// Per-user dismissal of the website banner. Bell/Telegram copies are not
// "dismissed" here — this only hides the sticky banner for that user.
model AnnouncementDismissal {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

// ── BLOG / CONTENT (SEO) ────────────────────────────────────────────────────
// Admin-authored posts surfaced publicly at /blog and /blog/[slug]. `bodyHtml`
// is sanitized rich HTML produced by the admin TipTap editor. Images live on
// Cloudinary (BLOG_IMAGE folder); videos are EMBEDDED (YouTube/Drive/Telegram),
// never self-hosted. The SEO fields drive <head> meta tags + Article JSON-LD so
// the post is discoverable by Google and citable by AI answer engines.
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  bodyHtml        String
  coverImageUrl     String?
  coverImageAlt     String?
  coverImageCaption String?

  status          String    @default("draft") // draft | published
  publishedAt     DateTime?
  scheduledFor    DateTime?

  tags            String[]  @default([])
  category        String?
  subcategory     String?

  // Denormalized authorship — no FK, so we don't touch the User relation graph.
  authorId        String?
  authorName      String    @default("RupChain")

  // SEO fields (all optional; sensible fallbacks computed at render time).
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  ogImageUrl      String?
  canonicalUrl    String?
  noindex         Boolean   @default(false)

  viewCount       Int       @default(0)
  readingMinutes  Int       @default(1)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
  @@index([subcategory])
}

// Newsletter opt-ins captured from the public blog sidebar. Email-only, no
// account required; `source` records which surface the signup came from.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?  // e.g. "blog", "blog:<slug>"
  // Signup geo — best-effort, captured once at opt-in for email-marketing
  // segmentation. Null for rows created before this was added, or when the
  // client IP could not be geolocated.
  country   String?
  ipAddress String?
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── LIVE SUPPORT CHAT ──────────────────────────────────────────────────────
// User-to-admin support conversations. One open conversation per user; admins
// reply from the admin panel. Delivery is via polling (see support routes).

model SupportConversation {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String           @default("open") // open | closed
  lastMessageAt DateTime         @default(now())
  unreadByAdmin Boolean          @default(false)
  unreadByUser  Boolean          @default(false)
  createdAt     DateTime         @default(now())
  messages      SupportMessage[]

  @@index([userId])
  @@index([status, lastMessageAt])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String              // "user" | "admin" | "system"
  senderId       String?
  body           String
  // Optional image attachment (Cloudinary URL). A message may carry an image with
  // an empty body (image-only) or alongside a caption.
  attachmentUrl  String?
  // Soft delete: set when a party retracts their own message. The row (body +
  // attachmentUrl) is RETAINED for admin / dispute review; regular users see a
  // "message was deleted" tombstone in its place. Never hard-deleted.
  deletedAt      DateTime?
  rating         Int?                // 1=bad 2=okay 3=great — only on sender="system" satisfaction messages
  // Structured message kind. "text" (default) is a plain chat bubble. "refund_request"
  // is an admin-issued prompt that renders as a refund-destination form in the user's
  // chat (metadata: { orderRef, chain, paymentNetwork }). "refund_response" is the
  // user's structured answer (metadata: { requestId, address, network, orderRef }).
  kind           String              @default("text")
  metadata       Json?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  keys      Json
  userAgent String?
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String?
  template  String
  toEmail   String
  status    String   @default("sent")
  sentAt    DateTime @default(now())

  @@index([userId])
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  type      String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model Session {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SessionType @default(refresh)
  token     String      @unique
  userAgent String?
  ip        String?
  createdAt DateTime    @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ADMIN NOTIFICATIONS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum AdminNotifCategory {
  KYC
  TRADE
