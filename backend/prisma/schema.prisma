  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coin        String
  network     String
  direction   RateAlertDirection
  targetRate  Decimal            @db.Decimal(14, 2)
  status      RateAlertStatus    @default(active)
