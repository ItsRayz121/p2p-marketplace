/// A reusable terms-and-conditions template a maker can save and re-insert when
/// creating future ads, so they don't retype the same terms every time.
model SavedTerms {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
