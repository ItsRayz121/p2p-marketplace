  @@index([userId, createdAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// GAS FEE SYSTEM (GAS_FEE_SPEC.md Section 7)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model GasFeeOrder {
  id                  String            @id @default(cuid())
  orderRef            String            @unique
  userId              String?
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  merchantApiKeyId    String?
  merchantApiKey      MerchantApiKey?   @relation(fields: [merchantApiKeyId], references: [id], onDelete: SetNull)
  ipAddress           String?
  riskScore           Int?              // 0-100; set by gas.risk.ts on order creation

  chain               GasChain
  tier                GasFeeTier?       // nullable: new custom-amount orders skip fixed tiers
  gasTokenConfigId    String?
  gasTokenConfig      GasTokenConfig?   @relation(fields: [gasTokenConfigId], references: [id], onDelete: SetNull)
  gasAmountNative     Decimal           @db.Decimal(18, 8)
  gasAmountUSD        Decimal           @db.Decimal(10, 4)
  priceAtOrder        Decimal           @db.Decimal(18, 8)

  paymentCoin          String            @default("USDT")
  paymentNetwork       String
  paymentAmount        Decimal           @db.Decimal(10, 4)
  // Platform margin component of paymentAmount, recorded immutably at creation
  // (paymentAmount = gasAmountUSD base cost + platformMarginUsdt margin). This is
  // the ONLY pool that promo discounts / referral rewards may ever draw from.
  // Nullable for back-compat: orders created before the promo system have it null.
  platformMarginUsdt   Decimal?          @db.Decimal(10, 4)
  // Discount applied to the margin at creation (>= 0, never exceeds the margin),
  // already baked into paymentAmount. Default 0 = no discount (current behavior).
  discountUsdt         Decimal           @default(0) @db.Decimal(10, 4)
  promoCodeId          String?           // set when a promo code was applied (Phase 1)
  gasFreeCodeId        String?           // set when a KOL free-gas code was applied (100% free: base + margin)
  // Affiliate buyer auto-discount snapshot (Phase 5) — the portion of discountUsdt that
  // came from the buyer's affiliate link, plus the referrer's display name at order time.
  // Lets the checkout/tracking screens show "X% off courtesy of <referrer>" after refresh.
  affiliateDiscountUsdt Decimal          @default(0) @db.Decimal(10, 4)
  affiliateReferrer     String?
  // true = an admin-issued free-gas delivery: paymentAmount is 0 and the platform
  // funds the FULL cost (base + margin). The order is created already in
  // payment_detected so it routes straight to the normal delivery worker.
  isFreeGrant          Boolean           @default(false)
  trackingToken        String?           @unique  // guest order privacy token (192-bit hex)
  paymentTxHash        String?           @unique
  paymentSenderAddress String?
  paymentProofUrl      String?
  paymentVerifiedAt    DateTime?
  verifiedAmount       Decimal?          @db.Decimal(10, 4)
  verifiedAsset        String?
  verifiedConfirmations Int?
  pkrPaymentMethod     String?
  pkrAmount            Decimal?          @db.Decimal(12, 2)

  toAddress           String
  fromHotWallet       String?
  deliveryTxHash      String?
  deliveryConfirmed   Boolean           @default(false)

  refundTxHash        String?
  refundAmount        Decimal?          @db.Decimal(10, 4)
  // When set (on a delivery-failed order), the moment after which the user may
  // request an immediate refund. Before this, the system keeps retrying delivery
  // and the UI shows a countdown. See lib/gas/gas.refundWindow.ts.
  refundEligibleAt    DateTime?
  // Refund destination the user supplied via the in-chat refund-address form (see
  // support refund_request/refund_response). Used to pre-fill the admin manual
  // refund modal — critical for PKR-paid orders that have no on-chain payer to
  // auto-resolve. The network is the USDT rail the user chose (BEP20/ERC20/TRC20/APTOS).
  suggestedRefundAddress String?
  suggestedRefundNetwork String?

  status              GasFeeOrderStatus @default(created)
  failureReason       String?
  retryCount          Int               @default(0)
  expiresAt           DateTime

  cancelledAt         DateTime?
  cancelReason        String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveredAt         DateTime?
  refundedAt          DateTime?

  ledgerEntries       GasLedgerEntry[]
  flaggedOrder        GasFlaggedOrder?
  promoCode           GasPromoCode?       @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoRedemption     GasPromoRedemption?
  gasFreeCode         GasFreeCode?        @relation(fields: [gasFreeCodeId], references: [id], onDelete: SetNull)
  freeCodeRedemption  GasFreeCodeRedemption?
  referralAccrual     GasReferralAccrual?

  @@index([status, expiresAt])
  @@index([userId])
  @@index([orderRef])
  @@index([promoCodeId])
  @@index([gasFreeCodeId])
}

// User-initiated gas-order cancellations, used to drive the abuse/cooldown ladder.
// Identity is the userId when authenticated, otherwise the client IP for guests.
// A rolling 7-day count of these events determines the cooldown a user incurs
// before they may place another gas order (see lib/gas/gas.cancellation.ts).
model GasCancellationEvent {
  id        String   @id @default(cuid())
  identity  String   // "user:<id>" or "ip:<addr>"
  userId    String?
  ipAddress String?
  orderId   String
  orderRef  String
  createdAt DateTime @default(now())

  @@index([identity, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// GAS PROMO CODES (margin-only discounts for marketing / KOL campaigns)
// A promo code discounts ONLY the platform margin of a gas order, never the base
// gas cost. Each code is self-contained: its own tiers, budget and counters — codes
// never interact. Discount = min(pct% × margin, margin), so a fully-discounted
// order still pays the base cost and is never a loss. See lib/gas/gas.promo.ts.
// ────────────────────────────────────────────────────────────────────────────
model GasPromoCode {
  id                 String   @id @default(cuid())
  code               String   @unique           // stored UPPERCASE; matched case-insensitively
  ownerLabel         String                      // KOL / campaign name (admin reference)
  // Ordered redemption tiers consumed first-come: [{ maxRedemptions:int, discountPct:number }].
  // discountPct is a % of the order's platform margin (0-100). Once all tier slots are
  // used, defaultDiscountPct applies to everyone after.
  tiers              Json     @default("[]")
  defaultDiscountPct Float    @default(0)
  // Lifetime cap on margin (USDT) this code may give away. Auto-disables when reached.
  marginBudgetUsdt   Float
  marginSpentUsdt    Float    @default(0)
  totalRedemptions   Int      @default(0)        // also the next slot index (optimistic-lock key)
  perUserLimit       Int      @default(1)        // max redemptions per identity (user or IP)
  minOrderUsd        Float    @default(0)        // min order value (pre-discount) to qualify
  expiresAt          DateTime?
  isActive           Boolean  @default(true)     // admin kill switch
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  redemptions        GasPromoRedemption[]
  orders             GasFeeOrder[]

  @@index([isActive])
}

// One row per successful redemption. orderId is unique (one code per order). The
// row is created in lock-step with the order; the code's counters are advanced
// atomically at reservation time (see gas.promo.ts reservePromo).
model GasPromoRedemption {
  id           String       @id @default(cuid())
  promoCodeId  String
  promoCode    GasPromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  identity     String        // "user:<id>" or "ip:<addr>"
  userId       String?
  orderId      String        @unique
  order        GasFeeOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountUsdt Decimal       @db.Decimal(10, 4)
  marginUsdt   Decimal       @db.Decimal(10, 4)  // margin the discount was computed against
  tierIndex    Int                                // tier slot used; -1 = default tier
  createdAt    DateTime      @default(now())

  @@index([promoCodeId])
  @@index([identity])
}

// ────────────────────────────────────────────────────────────────────────────
// GAS FREE CODES (KOL "100% free" giveaway codes — self-serve, instant, capped)
// Unlike GasPromoCode (margin-only discount), a free code waives the ENTIRE order
// cost (base + margin) — the platform genuinely pays for the gas. Each redemption
// gives a FIXED native gas amount (amountNative, e.g. 0.00001 BNB) — the user does
// not choose the amount; it is set once by the admin and identical for every
// redeemer. Restricted to ONE specific token/chain (gasTokenConfigId), capped by
// a first-come slot count (slotLimit) AND a lifetime USDT budget (budgetUsdt) —
// whichever is hit first auto-disables the code. Requires login and is available
// ONLY on a user's first-ever gas order (see gas.freeCode.ts assertFirstGasOrder) —
// the checkout UI hides the code box entirely once that's no longer true. Applied
// directly at checkout (no admin draw/send step, unlike GasGiveawayCampaign) — the
// resulting order is created already in payment_detected so it routes straight to
// delivery, same trick as an admin free-grant order. See lib/gas/gas.freeCode.ts.
// ────────────────────────────────────────────────────────────────────────────
model GasFreeCode {
  id               String   @id @default(cuid())
  code             String   @unique           // stored UPPERCASE; matched case-insensitively
  kolLabel         String                      // KOL / campaign name (admin reference)
  gasTokenConfigId String                      // which token+chain this code is valid for (plain ref)
  amountNative     Decimal  @db.Decimal(18, 8) // fixed gas amount every redeemer receives
  slotLimit        Int                          // total first-come redemptions allowed
  redeemedCount    Int      @default(0)        // also the next slot index (optimistic-lock key)
  // Lifetime cap on TOTAL order cost (base + margin, USDT) this code may give away.
  // Auto-disables when reached, even if slots remain.
  budgetUsdt       Float
  spentUsdt        Float    @default(0)
  perUserLimit     Int      @default(1)        // max redemptions per identity (moot in practice — first-order gate already limits to 1 lifetime redemption per user)
  expiresAt        DateTime?
  isActive         Boolean  @default(true)     // admin kill switch; also auto-flips off on exhaustion
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  redemptions      GasFreeCodeRedemption[]
  orders           GasFeeOrder[]

  @@index([isActive])
}

// One row per successful redemption. orderId is unique (one code per order). The
// row is created in lock-step with the order; the code's counters are advanced
// atomically at reservation time (see gas.freeCode.ts reserveFreeCode).
model GasFreeCodeRedemption {
  id           String      @id @default(cuid())
  freeCodeId   String
  freeCode     GasFreeCode @relation(fields: [freeCodeId], references: [id], onDelete: Cascade)
  identity     String       // "user:<id>" or "ip:<addr>"
  userId       String?
  orderId      String       @unique
  order        GasFeeOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountUsdt   Decimal      @db.Decimal(10, 4)  // full order cost waived (base + margin)
  createdAt    DateTime     @default(now())

  @@index([freeCodeId])
  @@index([identity])
}

// ────────────────────────────────────────────────────────────────────────────
// GAS REFERRALS (KOL income — share of the platform margin, paid from margin only)
// A referrer (any user) gets a code; a referred user is bound first-touch and stays
// bound for life. Each delivered, paid gas order by a referred user accrues
// referralPct × the REALIZED margin (margin after any promo discount) to the
// referrer's internal balance. Free-grant orders (platform-funded) never accrue.
// See lib/gas/gas.referral.ts. Display-only until Phase 5 adds withdrawal.
// ────────────────────────────────────────────────────────────────────────────
model GasReferralCode {
  id              String   @id @default(cuid())
  code            String   @unique          // stored UPPERCASE
  ownerId         String
  owner           User     @relation("GasRefCodeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  referralPct     Float    @default(5)       // commission %: % of gross margin paid to the owner
  // Affiliate split (Phase 5). When the owner is an approved affiliate, a buyer bound to
  // this code gets userDiscountPct% of the margin off automatically, and the owner earns
  // referralPct% of the margin. Invariant enforced at write time:
  // userDiscountPct + referralPct <= GasAffiliate.maxMarginPct <= 100.
  userDiscountPct Float    @default(0)       // % of margin auto-discounted to the bound buyer
  label           String?                    // affiliate-facing nickname for this link
  isActive        Boolean  @default(true)
  // Soft-delete for self-service custom links. When set, the link is hidden from the
  // owner's manage list + excluded from the active-link cap, and stops carrying a buyer
  // discount — but it STILL resolves to its owner (old shared links never break) and
  // any existing bindings keep accruing commission. The base (oldest) code is never deleted.
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  referrals       GasReferral[]

  @@index([ownerId])
}

// Affiliate profile (Phase 5): a user APPLIES to become an affiliate (submitting their
// social profiles); a super-admin approves and sets the margin caps. Approval turns the
// user's referral codes into affiliate links that BOTH discount the bound buyer and pay
// the affiliate a commission — always margin-only, never below the base gas cost.
// Inert unless gas_affiliate_enabled is ON.
model GasAffiliate {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation("GasAffiliateUser", fields: [userId], references: [id], onDelete: Cascade)
  status             String    @default("pending") // pending | approved | rejected
  socials            Json?                          // submitted social-media handles/links
  applicantNote      String?                        // optional message from the applicant
  rejectionReason    String?
  maxMarginPct       Float     @default(20)         // admin cap: total margin % the affiliate may allocate (discount + commission)
  minUserDiscountPct Float     @default(0)          // admin floor: minimum buyer discount % per link
  maxLinks           Int       @default(2)          // admin cap: how many affiliate links the user may create
  reviewedById       String?                        // admin who approved/rejected (no FK; audit only)
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
}

// First-touch binding: a referred user maps to exactly one referrer, permanently.
model GasReferral {
  id          String          @id @default(cuid())
  referredId  String          @unique
  referred    User            @relation("GasReferredUser", fields: [referredId], references: [id], onDelete: Cascade)
  referrerId  String
  referrer    User            @relation("GasReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  codeId      String
  code        GasReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@index([referrerId])
}

// One accrual per delivered order (orderId unique → idempotent). Recorded after the
// order reaches 'delivered' (terminal success; delivered orders are never refunded),
// so a failed/refunded order never pays commission.
model GasReferralAccrual {
  id          String      @id @default(cuid())
  referrerId  String
  referrer    User        @relation("GasReferrerAccrual", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String
  orderId     String      @unique
  order       GasFeeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  marginUsdt  Decimal     @db.Decimal(10, 4)  // realized margin the % was taken on
  amountUsdt  Decimal     @db.Decimal(10, 4)
  pct         Float
  status      String      @default("available") // available | withdrawn | reversed
  createdAt   DateTime    @default(now())

  @@index([referrerId, status])
}

// ────────────────────────────────────────────────────────────────────────────
// GAS GIVEAWAYS (KOL campaigns — entry pool + admin draw → free gas to winners)
// People enter a KOL-branded campaign with their receiving address; an admin later
// draws N winners and free gas is delivered to the selected addresses (reusing the
// Phase 3 free-delivery path). Payout is decoupled from entry, so cost is fixed at
// winners × amount no matter how many enter. See gasFee.routes giveaway endpoints.
// ────────────────────────────────────────────────────────────────────────────
model GasGiveawayCampaign {
  id               String   @id @default(cuid())
  code             String   @unique          // KOL code entrants type; stored UPPERCASE
  kolLabel         String                      // KOL / campaign name (shown to entrants)
  thumbnailUrl     String?                     // optional banner shown on the public entry page
  gasTokenConfigId String                      // which token winners receive (plain ref)
  amountNative     Decimal  @db.Decimal(18, 8) // fixed gas amount each winner gets
  winnerCount      Int                          // target number of winners
  drawnCount       Int      @default(0)
  entryDeadline    DateTime?
  requireKyc       Boolean  @default(true)      // require KYC1 to enter
  status           String   @default("open")    // open | drawn | closed
  isActive         Boolean  @default(true)       // kill switch
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entries          GasGiveawayEntry[]

  @@index([isActive, status])
}

model GasGiveawayEntry {
  id               String              @id @default(cuid())
  campaignId       String
  campaign         GasGiveawayCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId           String                                  // entrant (plain ref)
  email            String?
  receivingAddress String
  status           String              @default("entered") // entered | won | not_selected
  orderId          String?                                 // free-gas order created on win (plain ref)
  createdAt        DateTime            @default(now())

  @@unique([campaignId, userId])      // one entry per user per campaign
  @@index([campaignId, status])
}

// ── Community / Influencer giveaways ─────────────────────────────────────────
// Off-platform, task-gated address-collection giveaways created self-service by
// affiliates (and admins). The platform is the entry form + task gate + CSV
// export; the CREATOR distributes the reward themselves — no platform funds are
// ever moved here (that stays exclusive to GasGiveawayCampaign, admin-only).
model PromoGiveaway {
  id            String               @id @default(cuid())
  code          String               @unique             // shareable entry code (UPPERCASE)
  title         String                                    // shown to entrants
  description   String?                                   // details / reward description
  thumbnailUrl  String?
  tasks         Json?                                     // [{ id, label, url, required }]
  addressLabel  String?                                   // e.g. "USDT BEP20 wallet address"
  resultsSheetUrl String?                                 // creator-uploaded proof sheet (public transparency)
  winnerCount   Int                  @default(0)          // target winners (ignored when rewardAll)
  rewardAll     Boolean              @default(false)      // everyone who entered wins
  requireKyc    Boolean              @default(false)
  // Off-platform reward metadata (display-only — no funds move). Lets the creator
  // spell out what winners receive: amount + token + chain (chain may be a custom
  // "Other" value not in the platform's gas list).
  rewardAmount  String?                                   // e.g. "500" or "0.5"
  rewardToken   String?                                   // token symbol / title, e.g. "USDT", "PKR"
  rewardChain   String?                                   // chain label, e.g. "BEP20", "TRON", or custom
  // Optional entrant fields the creator can collect at entry time.
  collectName   Boolean              @default(false)      // ask entrant for a name / username
  collectWhatsapp Boolean            @default(false)      // ask entrant for a WhatsApp number
  entryDeadline DateTime?
  status        String               @default("open")     // open | closed
  isActive      Boolean              @default(true)       // admin kill switch
  createdById   String                                    // creator (affiliate or admin) — plain ref
  createdByRole String                                    // snapshot: affiliate | admin | super_admin
  createdByName String?                                   // snapshot display name for admin oversight
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  entries       PromoGiveawayEntry[]

  @@index([isActive, status])
  @@index([createdById])
}

model PromoGiveawayEntry {
  id               String        @id @default(cuid())
  giveawayId       String
  giveaway         PromoGiveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  userId           String                              // entrant (plain ref)
  username         String?                             // snapshot for CSV export
  email            String?
  entrantName      String?                             // optional name/username the entrant supplied
  whatsapp         String?                             // optional WhatsApp number the entrant supplied
  receivingAddress String
  ackTasks         Json?                               // task ids the entrant confirmed
  status           String        @default("entered")   // entered | pending | sent | rejected
  note             String?                             // creator note — required justification when rejected
  createdAt        DateTime      @default(now())

  @@unique([giveawayId, userId])     // one entry per user per giveaway
  @@index([giveawayId, status])
}

model GasHotWallet {
  id                   String    @id @default(cuid())
  chain                GasChain
  address              String
  hdIndex              Int       @default(0)   // BIP44 child index for this wallet
  weight               Int       @default(100) // load-balancing weight; higher = preferred
  isActive             Boolean   @default(true)
  lastBalanceRefreshAt DateTime?
  createdAt            DateTime  @default(now())

  @@unique([chain, hdIndex])
  @@index([chain, isActive])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// GAS CHAIN & TOKEN CONFIGURATION (admin-controlled, no code change to add chains)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model GasChainConfig {
  id             String           @id @default(cuid())
  name           String           // "TRON", "BNB Smart Chain", "Ethereum"
  slug           String           @unique // "TRON", "BSC", "ETH", "BASE", "ARB", "MATIC", "OP", "SOL", "TON", "SUI"
  symbol         String           // "TRX", "BNB", "ETH"
  logoUrl        String?
  category       String           // "tron" | "bnb" | "ethereum" | "solana" | "ton" | "sui"
  networkLabel   String           // "TRC20", "BEP20", "ERC20", "Solana", "TON", "SUI"
  addressType    String           // "TRC20" | "EVM" | "SOL" | "TON" | "SUI" â€” maps to frontend regex
  explorerBase   String?
  backendChainId    String?          // Maps to GasChain enum value. Null = not yet deliverable.
  platformFeeUsdt   Float            @default(0.25) // Default platform fee (USDT) â€” used when token has no override
  alertThresholdUsd Float?           // Auto-alert below this USD wallet balance; null = no alert
  pauseThresholdUsd Float?           // Auto-pause new orders below this USD balance; null = no pause
  defaultMinAmount  Decimal?         @db.Decimal(18, 8) // Default min amount for tokens under this chain
  defaultMaxUsdValue Decimal?        @db.Decimal(10, 4) // Default max USD value for tokens under this chain
  isActive          Boolean          @default(true)
  isVisibleToUsers  Boolean          @default(true)  // false = hidden from all user-facing APIs and UI
  // true = removed from the main admin list into an "Archived" section. Implies
  // hidden from users; kept (not deleted) so it can be unarchived or removed later.
  isArchived        Boolean          @default(false)
  // Feature readiness state: inactive | testing | beta | stable
  // inactive = hidden from public UI; stable = fully operational
  readinessState    String           @default("inactive")
  displayOrder   Int              @default(0)

  // ── Operational / chain-registry fields ───────────────────────────────────
  // chainType drives dispatch in fee calculator, balance monitor, and payment poller.
  // Values: "EVM" | "APTOS" | "TRON" | "SOLANA" | "TON" | "SUI" | "CUSTOM"
  chainType             String           @default("EVM")
  // Primary and fallback RPC URLs for balance fetching and fee estimation.
  rpcUrl                String?
  rpcUrlFallback        String?
  // How network fee is estimated. Values: "EVM_RPC" | "APTOS_API" | "TRON_API" | "SOLANA_API" | "TON_API" | "FIXED" | "CUSTOM"
  feeMethod             String           @default("EVM_RPC")
  fixedFeeUsd           Decimal?         @db.Decimal(10, 6)
  // CoinGecko ID for native token price feed (e.g. "aptos", "binancecoin", "tron").
  coingeckoId           String?
  // This chain can receive USDT payments from users.
  isPaymentEnabled      Boolean          @default(false)
  // Override deposit address for USDT payments; null = derive from mnemonic.
  depositAddressOverride String?
  // USDT contract address on this chain (for payment detection).
  usdtContractAddress   String?
  usdtDecimals          Int              @default(6)

  tokens         GasTokenConfig[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model GasTokenConfig {
  id              String         @id @default(cuid())
  chainConfigId   String
  chain           GasChainConfig @relation(fields: [chainConfigId], references: [id], onDelete: Cascade)
  name            String         // "TRX", "BNB", "USDT (TRC20)"
  symbol          String         // "TRX", "BNB", "USDT"
  tokenType       String         // "native" | "token"
  contractAddress String?
  logoUrl         String?
  priceSymbol     String         // “TRX”, “BNB”, “ETH” — Redis rate key for pricing
  coingeckoId     String?        // CoinGecko ID override; null = use chain-level coingeckoId
  platformFeeUsdt Float?         // Override; null = inherit from parent chain default
  minAmount       Decimal?       @db.Decimal(18, 8) // Override; null = inherit from parent chain default
  maxUsdValue     Decimal?       @db.Decimal(10, 4) // Override; null = inherit from parent chain default
  presetAmounts   Json           // number[] e.g. [10, 50, 100, 200]
  isActive        Boolean        @default(true)
  isVisibleToUsers Boolean       @default(true)  // false = hidden from user-facing APIs and dropdowns
  // true = removed from the main admin list into an "Archived" section. Implies
  // hidden from users; kept (not deleted) so it can be unarchived or removed later.
  isArchived      Boolean        @default(false)
  // Non-native token delivery (real funds) — orderable only when this is true AND
  // the chain family has a delivery implementation. Default false: must be flipped
  // by a super-admin after the hot wallet is funded with the token + native gas.
  deliveryLive    Boolean        @default(false)
  displayOrder    Int            @default(0)
  orders          GasFeeOrder[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([chainConfigId, isActive])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// HD-DERIVED DEPOSIT INFRASTRUCTURE
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// One HD-derived deposit address per user per chain family. EVM family addresses
// are shared across all EVM chains (Eth, BSC, Polygon, Arb, Op, Base). The
// derivation index is a monotonic counter â€” see PlatformConfig key
// `next_evm_derivation_index` for allocation.
model DepositAddress {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  chainFamily      String   // 'EVM' for now; 'TRON' | 'TON' | 'SUI' later
  address          String
  derivationIndex  Int
  createdAt        DateTime @default(now())

  subscriptions    MoralisStreamSubscription[]

  @@unique([userId, chainFamily])
  @@unique([address])
  @@index([chainFamily])
}

// One row per (DepositAddress, chain) tracking Moralis Stream subscription
// state. We create one row per supported EVM chain when a new DepositAddress
// is generated, then a worker walks the rows in status='pending' and POSTs
// the address into each chain's Moralis Stream. Idempotent: the unique
// constraint prevents duplicate enqueueing for the same address/chain.
model MoralisStreamSubscription {
  id                 String          @id @default(cuid())
  depositAddressId   String
  depositAddress     DepositAddress  @relation(fields: [depositAddressId], references: [id], onDelete: Cascade)
  chain              String          // matches ChainConfig.id ('ethereum', 'bsc', â€¦)
  streamId           String?         // null until the operator sets MORALIS_STREAM_ID_<CHAIN>
  status             String          @default("pending") // pending | subscribed | failed | skipped
  attempts           Int             @default(0)
  lastError          String?
  lastAttemptAt      DateTime?
  subscribedAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([depositAddressId, chain])
  @@index([status])
  @@index([chain, status])
}

// Append-only audit trail of every on-chain deposit we've seen. A row exists
// from the moment the deposit-watcher first observes the transaction;
// `creditedAt` flips once confirmations meet the chain threshold and we move
// the funds into the user's internal Wallet balance.
model Deposit {
  id                   String   @id @default(cuid())
  txHash               String
  chain                String   // matches ChainConfig.id (ethereum, bsc, ...)
  asset                String   // ERC20 contract address or 'native'
  symbol               String   // resolved symbol (USDT, USDC, ETH, ...)
  fromAddress          String
  toAddress            String
  amount               Decimal  @db.Decimal(38, 18)
  confirmations        Int      @default(0)
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  walletId             String?
  creditedTransactionId String?
  status               String   @default("detected") // detected | credited | rejected
  rejectionReason      String?
  detectedAt           DateTime @default(now())
  creditedAt           DateTime?

  @@unique([txHash, chain, asset])
  @@index([toAddress])
  @@index([userId])
  @@index([status])
}

// Maker collateral bond hold (non-custodial Phase 5). One row per trade records
// the USDT bond locked from the maker's deposited balance while a trade is open.
// status gate (held → released | seized) makes lock/release/seize idempotent and
// exactly-once, mirroring the Deposit detected→credited pattern. walletId pins
// the exact USDT wallet the bond is locked in, so release/seize are unambiguous.
model BondHold {
  id          String    @id @default(cuid())
  tradeType   String    // 'usdt' | 'ctm'
  tradeId     String
  makerId     String
  maker       User      @relation("BondHoldMaker", fields: [makerId], references: [id], onDelete: Restrict)
  walletId    String
  amount      Decimal   @db.Decimal(18, 8) // USDT bond amount
  status      String    @default("held")   // held | released | seized
  victimId    String?                       // counterparty credited on seize
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@unique([tradeType, tradeId])
  @@index([makerId])
  @@index([status])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// MERCHANT API KEYS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// API keys for programmatic gas fee access.
// Key format: mpak_{keyId}_{secret}
// Only `keyId` and a bcrypt hash of `secret` are stored.
model MerchantApiKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  keyId       String   @unique  // short unique token embedded in the key for O(1) lookup
  keyHash     String            // bcrypt hash of the secret portion
  keyPrefix   String            // first 14 chars of full key â€” display only
  name        String            // "My App Integration"

  isActive    Boolean  @default(true)
  rateLimit   Int      @default(60)   // max requests per minute
  lastUsedAt  DateTime?

  webhookUrl     String?   // POST target for order status callbacks
  webhookSecret  String?   // HMAC-SHA256 signing secret for callbacks

  createdAt   DateTime @default(now())

  gasOrders       GasFeeOrder[]
  merchantAccount GasMerchantAccount?

  @@index([userId])
  @@index([isActive])
}

model GasCustomRequest {
  id             String                  @id @default(cuid())
  blockchainName String
  token          String
  amount         String?
  purpose        String
  urgency        String                  @default("normal")
  details        String?
  contactEmail   String?
  ipAddress      String?
  status         GasCustomRequestStatus  @default(pending)
  adminNotes     String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status])
  @@index([createdAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// TREASURY WALLET
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// One row per chain-family (TRON / EVM). Treasury lives at HD index 100/101 on
// the same mnemonic as the hot wallet (index 0). Never signs delivery txns.
model GasTreasuryWallet {
  id                   String    @id @default(cuid())
  chain                GasChain  @unique  // representative chain (TRON or ETH for EVM family)
  chainFamily          String    // 'TRON' | 'EVM'
  address              String    @unique
  derivationIndex      Int                // 100 = TRON treasury, 101 = EVM treasury
  isActive             Boolean   @default(true)
  lastBalanceRefreshAt DateTime?
  createdAt            DateTime  @default(now())

  refillRequests       GasRefillRequest[]

  @@index([chainFamily, isActive])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// INTERNAL ACCOUNTING LEDGER
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Append-only. Never update a row â€” write a new corrective entry instead.
model GasLedgerEntry {
  id             String               @id @default(cuid())
  entryType      GasLedgerEntryType
  chain          GasChain
  // nativeAmount: positive = inflow to hot wallet; negative = outflow
  nativeAmount   Decimal              @db.Decimal(28, 10)
  nativeSymbol   String               // "TRX", "BNB", "ETH", etc.
  tokenSymbol    String?              // "USDT" for ERC20 payments; null for native-only entries
  tokenAmount    Decimal?             @db.Decimal(28, 10)
  usdAmount      Decimal              @db.Decimal(18, 6)
  txHash         String?
  fromAddress    String?
  toAddress      String?
  sourceKey      String?              @unique
  relatedOrderId String?
  relatedOrder   GasFeeOrder?         @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedRefillId String?
  relatedRefill  GasRefillRequest?    @relation(fields: [relatedRefillId], references: [id], onDelete: SetNull)
  notes          String?              @db.VarChar(500)
  createdAt      DateTime             @default(now())

  @@index([chain, entryType])
  @@index([txHash])
  @@index([relatedOrderId])
  @@index([relatedRefillId])
  @@index([createdAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// HOT-WALLET REFILL SYSTEM
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Per-chain thresholds that drive auto-refill. One row per GasChain.
model GasRefillThreshold {
  id                  String    @id @default(cuid())
  chain               GasChain  @unique
  // Trigger a refill when hot wallet native balance falls below this amount
  triggerBelowNative  Decimal   @db.Decimal(18, 8)
  // After a refill, target this native balance (what to refill TO)
  refillTargetNative  Decimal   @db.Decimal(18, 8)
  // Max single-transfer size (safety cap on each refill tx)
  maxRefillNative     Decimal   @db.Decimal(18, 8)
  isEnabled           Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([isEnabled])
}

// Lifecycle: pending_approval â†’ approved â†’ executing â†’ completed
//                             â†˜ cancelled
//                                        â†˜ failed (retriable)
model GasRefillRequest {
  id              String                  @id @default(cuid())
  chain           GasChain
  fromWalletId    String
  fromWallet      GasTreasuryWallet       @relation(fields: [fromWalletId], references: [id], onDelete: Restrict)
  fromAddress     String
  toAddress       String                  // hot wallet address
  nativeAmount    Decimal                 @db.Decimal(18, 8)
  nativeSymbol    String
  usdAmount       Decimal                 @db.Decimal(18, 6)
  status          GasRefillRequestStatus  @default(pending_approval)
  // Set when hot-wallet balance that triggered this refill was sampled
  triggerBalance  Decimal?                @db.Decimal(18, 8)

  approvedAt      DateTime?
  approvedBy      String?                 // admin userId
  cancelledAt     DateTime?
  cancelledBy     String?
  executedAt      DateTime?
  completedAt     DateTime?
  txHash          String?
  failureReason   String?                 @db.VarChar(500)
  retryCount      Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  ledgerEntries   GasLedgerEntry[]

  @@index([chain, status])
  @@index([status])
  @@index([createdAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PHASE 4 â€” RECONCILIATION ENGINE
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model GasReconciliationRun {
  id               String   @id @default(cuid())
  ranAt            DateTime @default(now())
  chain            GasChain?
  totalOrders      Int      @default(0)
  ordersChecked    Int      @default(0)
  discrepancyCount Int      @default(0)
  status           String   // running | complete | failed
  notes            String?  @db.VarChar(1000)
  discrepancies    GasReconciliationDiscrepancy[]

  @@index([status])
  @@index([ranAt])
}

model GasReconciliationDiscrepancy {
  id          String   @id @default(cuid())
  runId       String
  run         GasReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  orderId     String?
  type        String   // delivery_tx_not_found | amount_mismatch | payment_not_on_chain | stuck_sending
  description String   @db.VarChar(1000)
  resolvedAt  DateTime?
  resolvedBy  String?
  adminNote   String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  @@index([runId])
  @@index([orderId])
  @@index([type])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PHASE 5 â€” RISK / FRAUD FLAGGING
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model GasFlaggedOrder {
  id          String      @id @default(cuid())
  orderId     String      @unique
  order       GasFeeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reasons     String      // JSON array: ["HIGH_DEST_FREQUENCY", ...]
  riskScore   Int         // 0â€“100
  status      String      @default("pending_review") // pending_review | reviewed_ok | reviewed_blocked
  reviewedBy  String?
  reviewedAt  DateTime?
  adminNote   String?     @db.VarChar(500)
  createdAt   DateTime    @default(now())

  @@index([status])
  @@index([riskScore])
  @@index([createdAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PHASE 6 â€” MERCHANT SETTLEMENT
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model GasMerchantAccount {
  id              String   @id @default(cuid())
  name            String
  apiKeyId        String   @unique
  apiKey          MerchantApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)
  commissionRate  Decimal  @default(0) @db.Decimal(5, 4) // 0.0000â€“1.0000
  settlementCycle String   @default("weekly")            // daily | weekly | monthly
  payoutAddress   String?                                // USDT TRC20 for auto-payout
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  settlements     GasMerchantSettlement[]

  @@index([isActive])
}

model GasMerchantSettlement {
  id               String              @id @default(cuid())
  merchantId       String
  merchant         GasMerchantAccount  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  periodStart      DateTime
  periodEnd        DateTime
  orderCount       Int                 @default(0)
  grossRevenueUsd  Decimal             @db.Decimal(18, 6)
  platformFeeUsd   Decimal             @db.Decimal(18, 6)
  merchantShareUsd Decimal             @db.Decimal(18, 6)
  status           String              @default("pending") // pending | approved | paid
  payoutTxHash     String?
  paidAt           DateTime?
  adminNote        String?             @db.VarChar(500)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([merchantId, status])
  @@index([status])
  @@index([periodStart, periodEnd])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// COMMUNITY TOKEN MARKET (CTM)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model CtmToken {
  id                String            @id @default(cuid())
  slug              String            @unique
  symbol            String
  name              String
  description       String            @db.VarChar(2000)
  logoUrl           String?
  bannerUrl         String?
  settlementType    CtmSettlementType
  network           String?
  contractAddress   String?
  explorerUrl       String?
  // Optional receiving-address guardrails so a wrong-chain address can't be used.
  // addressExample is shown to users; addressRegex (JS source, no slashes) is
  // validated against submitted addresses at CTM trade start.
  addressExample    String?
  addressRegex      String?
  officialWebsite   String?
  officialTwitter   String?
  officialTelegram  String?
  whitePaperUrl     String?
  status            CtmTokenStatus    @default(pending_review)
  riskTier          CtmTokenRiskTier  @default(high)
  riskNotes         String?           @db.VarChar(1000)
  riskLabels        String[]          @default([])
  communityVerified Boolean           @default(false)
  verifiedByAdminId String?
  verifiedAt        DateTime?
  isListingEnabled  Boolean           @default(true)
  maxListingAmount  Decimal?          @db.Decimal(28, 8)
  minTradeAmountPkr Decimal?          @db.Decimal(14, 2)
  totalListings     Int               @default(0)
  totalTrades       Int               @default(0)
  totalVolumePkr    Decimal           @default(0) @db.Decimal(18, 2)
  lastTradedAt      DateTime?
  suggestedByUserId String?
  addedByAdminId    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  listings          CtmListing[]
  requests          CtmRequest[]
  tokenRequests     CtmTokenRequest[]
  trades            CtmTrade[]

  @@index([status, isListingEnabled])
  @@index([settlementType])
  @@index([slug])
}

model CtmTokenRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenId         String?
  token           CtmToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  tokenName       String
  tokenSymbol     String
  description     String    @db.VarChar(1000)
  officialWebsite String?
  evidenceUrl     String?
  status          String    @default("pending")
  adminNote       String?   @db.VarChar(500)
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

model CtmMerchantProfile {
  id                     String          @id @default(cuid())
  userId                 String          @unique
  user                   User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  merchantId             String?         @unique
  merchant               Merchant?       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  tier                   CtmMerchantTier @default(new)
  collateralAmount       Decimal         @default(0) @db.Decimal(18, 8)
  collateralCoin         String          @default("USDT")
  totalCtmTrades         Int             @default(0)
  completedCtmTrades     Int             @default(0)
  disputedCtmTrades      Int             @default(0)
  ctmDisputeRate         Decimal         @default(0) @db.Decimal(6, 4)
  ctmAvgRating           Decimal         @default(0) @db.Decimal(3, 2)
  settlementInstructions Json            @default("{}")
  isActive               Boolean         @default(true)
  suspendedUntil         DateTime?
  suspendReason          String?
  approvedAt             DateTime?
  approvedBy             String?
  lastActiveAt           DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  listings               CtmListing[]

  @@index([tier, isActive])
  @@index([userId])
}

model CtmListing {
  id                String             @id @default(cuid())
  listingRef        String             @unique @default(cuid())
  merchantProfileId String
  merchantProfile   CtmMerchantProfile @relation(fields: [merchantProfileId], references: [id], onDelete: Restrict)
  tokenId           String
  token             CtmToken           @relation(fields: [tokenId], references: [id], onDelete: Restrict)
  side              AdSide
  settlementType    CtmSettlementType
  priceType         PriceType          @default(fixed)
  pricePerUnit      Decimal            @db.Decimal(14, 2)
  totalAmount       Decimal            @db.Decimal(28, 8)
  availableAmount   Decimal            @db.Decimal(28, 8)
  lockedAmount      Decimal            @default(0) @db.Decimal(28, 8)
  minOrderPkr       Decimal?           @db.Decimal(14, 2)
  maxOrderPkr       Decimal?           @db.Decimal(14, 2)
  minOrderTokens    Decimal            @db.Decimal(28, 8)
  maxOrderTokens    Decimal            @db.Decimal(28, 8)
  settlementMethod  String             @db.VarChar(100)
  tokenDeliveryType String?            @db.VarChar(20)
  settlementNote    String             @db.VarChar(1000)
  paymentMethods    String[]
  // USDT-as-payment (flag+ready gated — see ctm/ctm.usdtPayment.ts). Default
  // "PKR" keeps every existing + new listing PKR-only unless the feature is
  // deliberately enabled, so these columns are inert until then.
  paymentCurrency   String             @default("PKR") @db.VarChar(10)
  // Selected USDT delivery methods (BEP20 / Aptos / Binance / OKX / …) when
  // paymentCurrency = USDT; empty for PKR listings.
  usdtPaymentMethods String[]          @default([])
  // Maker's USDT receive points for a SELL listing: [{ method, address, label }].
  usdtSettlementDestinations Json?
  tradeWindowMins   Int                @default(45)
  terms             String             @default("") @db.VarChar(2000)
  status            CtmListingStatus   @default(active)
  requiresProof     Boolean            @default(true)
  proofInstructions String?            @db.VarChar(500)
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  trades            CtmTrade[]
  listingBids       CtmListingBid[]

  @@index([tokenId, side, status])
  @@index([merchantProfileId])
}

model CtmRequest {
  id             String           @id @default(cuid())
  requestRef     String           @unique @default(cuid())
  userId         String
  user           User             @relation("CtmRequestUser", fields: [userId], references: [id], onDelete: Restrict)
  tokenId        String
  token          CtmToken         @relation(fields: [tokenId], references: [id], onDelete: Restrict)
  side           AdSide
  amount         Decimal          @db.Decimal(28, 8)
  targetPricePkr Decimal?         @db.Decimal(14, 2)
  paymentMethods String[]
  note           String?          @db.VarChar(500)
  status         CtmRequestStatus @default(open)
  expiresAt      DateTime
  acceptedBidId  String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  bids           CtmBid[]
  trade          CtmTrade?        @relation("CtmRequestTrade")

  @@index([tokenId, side, status])
  @@index([userId])
}

model CtmBid {
  id           String     @id @default(cuid())
  requestId    String
  request      CtmRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  bidderId     String
  bidder       User       @relation("CtmBidder", fields: [bidderId], references: [id], onDelete: Restrict)
  pricePerUnit Decimal    @db.Decimal(14, 2)
  totalPkr     Decimal    @db.Decimal(14, 2)
  message      String?    @db.VarChar(300)
  // Payment details captured at bid time so a request→trade has real account info
  // (previously a request trade had none → "account details not provided").
  // paymentMethods: the bidder's saved PaymentMethod id(s) — their PKR receiving
  //   account when the bidder is the seller. buyerSettlementId / buyerPaymentMethodId
  //   are set when the bidder is the BUYER (token receiving address + pay-from account).
  paymentMethods       String[]
  buyerSettlementId    String?   @db.VarChar(500)
  buyerPaymentMethodId String?   @db.VarChar(100)
  status       String     @default("pending")
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([requestId, status])
  @@index([bidderId])
}

model CtmTrade {
  id                String            @id @default(cuid())
  tradeRef          String            @unique @default(cuid())
  displayRef        String?           @unique
  listingId         String?
  listing           CtmListing?       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  requestId         String?           @unique
  request           CtmRequest?       @relation("CtmRequestTrade", fields: [requestId], references: [id], onDelete: Restrict)
  buyerId           String
  buyer             User              @relation("CtmTradeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId          String
  seller            User              @relation("CtmTradeSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  tokenId           String
  token             CtmToken          @relation(fields: [tokenId], references: [id])
  settlementType    CtmSettlementType
  tokenAmount       Decimal           @db.Decimal(28, 8)
  pricePerUnit      Decimal           @db.Decimal(14, 2)
  fiatAmount        Decimal           @db.Decimal(14, 2)
  paymentMethod          String
  paymentProofUrl        String?
  paymentProofHash       String?
  settlementMethod       String            @db.VarChar(100)
  buyerSettlementId      String?           @db.VarChar(500)
  sellerPaymentSnapshot  Json?
  buyerPaymentSnapshot   Json?
  // USDT-as-payment (flag+ready gated). Default "PKR" so existing trades are
  // untouched. When "USDT", the buyer pays the seller in USDT via usdtDeliveryMethod
  // (BEP20/Aptos/exchange) to usdtDeliveryAddress; usdtAmount is the USDT owed.
  paymentCurrency        String            @default("PKR") @db.VarChar(10)
  usdtDeliveryMethod     String?           @db.VarChar(40)
  usdtDeliveryAddress    String?           @db.VarChar(200)
  usdtAmount             Decimal?          @db.Decimal(28, 8)
  status            CtmTradeStatus    @default(awaiting_payment)
  // Dispute-resume — see the twin field on Trade. `status` stays parked at
  // `disputed`; this carries the real ladder rung so the parties can still settle.
  disputeResumeStatus CtmTradeStatus?
  // Taker-first settlement (Phase 1): true when this trade uses the reordered
  // BUY-listing flow (taker sends tokens first, merchant pays second). Stamped at
  // creation from isTakerFirstForMarket('ctm'); false = classic payment-first flow.
  takerFirst        Boolean           @default(false)
  proofDeadlineAt   DateTime?
  confirmDeadlineAt DateTime?
  expiresAt         DateTime
  cancelledBy       String?
  cancelReason      String?
  cancelledAt       DateTime?
  completedAt       DateTime?
  escrowAddress     String?           @db.VarChar(200)
  escrowAmount      Decimal?          @db.Decimal(28, 8)
  escrowCurrency    String?           @db.VarChar(20)
  escrowTxHash      String?           @db.VarChar(200)
  escrowConfirmedAt DateTime?
  platformFeePkr    Decimal?          @db.Decimal(14, 4)
  platformFeeUsdt   Decimal?          @db.Decimal(14, 6)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  listingBidId      String?           @unique
  listingBid        CtmListingBid?    @relation(fields: [listingBidId], references: [id], onDelete: SetNull)
  proofs            CtmTradeProof[]
  messages          CtmTradeMessage[]
  dispute           CtmDispute?
  ratings           CtmTradeRating[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([tradeRef])
  @@index([tokenId, status])
}

model CtmListingBid {
  id                   String      @id @default(cuid())
  listingId            String
  listing              CtmListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderId             String
  bidder               User        @relation("CtmListingBidder", fields: [bidderId], references: [id], onDelete: Restrict)
  pricePerUnit         Decimal     @db.Decimal(14, 2)
  tokenAmount          Decimal     @db.Decimal(28, 8)
  fiatAmount           Decimal     @db.Decimal(14, 2)
  message              String?     @db.VarChar(300)
  paymentMethod        String?     @db.VarChar(100)
  paymentMethods       String[]
  buyerSettlementId    String?     @db.VarChar(500)
  buyerPaymentMethodId String?     @db.VarChar(100)
  status               String      @default("pending")
  expiresAt            DateTime
  trade                CtmTrade?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([listingId, status])
  @@index([bidderId])
}

model CtmTradeProof {
  id              String       @id @default(cuid())
  tradeId         String
  trade           CtmTrade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  uploadedBy      String
  proofType       CtmProofType
  fileUrl         String?
  fileHash        String?
  txHash          String?
  txVerificationStatus String?  // verified | failed | mismatch_receiver | mismatch_amount | reverted | not_found | rpc_error | pending | skipped
  txVerificationDetails Json?
  description     String?      @db.VarChar(500)
  isAdminReviewed Boolean      @default(false)
  adminNote       String?      @db.VarChar(500)
  createdAt       DateTime     @default(now())

  @@index([tradeId])
  @@index([txHash])
}

model CtmTradeMessage {
  id            String   @id @default(cuid())
  tradeId       String
  trade         CtmTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  senderId      String
  message       String   @db.VarChar(1000)
  attachmentUrl String?
  // System (auto) messages posted by the platform on each step transition.
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([tradeId])
}

model CtmDispute {
  id                    String                 @id @default(cuid())
  tradeId               String                 @unique
  trade                 CtmTrade               @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  openedById            String
  reason                CtmDisputeReason
  description           String                 @db.VarChar(5000)
  status                DisputeStatus          @default(open)
  resolution            String?                @db.VarChar(2000)
  winner                DisputeWinner?
  resolutionType        DisputeResolutionType?
  flaggedForTokenReview Boolean                @default(false)
  escalatedAt           DateTime?
  resolvedAt            DateTime?
  resolvedBy            String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  messages              CtmDisputeMessage[]

  @@index([status])
}

model CtmDisputeMessage {
  id          String     @id @default(cuid())
  disputeId   String
  dispute     CtmDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId    String
  message     String     @db.VarChar(2000)
  evidenceUrl String?
  createdAt   DateTime   @default(now())

  @@index([disputeId])
}

model CtmTradeRating {
  id            String   @id @default(cuid())
  tradeId       String
  trade         CtmTrade @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  ratedByUserId String
  ratedUserId   String
  rating        Int
  comment       String?  @db.VarChar(500)
  tags          String[]
  createdAt     DateTime @default(now())

  @@unique([tradeId, ratedByUserId])
  @@index([ratedUserId])
}

