// PakSwap â€” Complete Prisma Schema
// Source: FULL_SPEC.md Section 18 + GAS_FEE_SPEC.md Section 7

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // PgBouncer setup (Railway):
  //   1. Set DATABASE_URL to PgBouncer URL (port 6543) + ?pgbouncer=true&connection_limit=1
  //   2. Add DIRECT_DATABASE_URL env var pointing to direct Postgres (port 5432)
  //   3. Uncomment: directUrl = env("DIRECT_DATABASE_URL")
  // Live check 2026-08-12: Railway Postgres max_connections=500, actual usage ~31 (6%).
  // No pool pressure at current scale — PgBouncer above is optional headroom, not a current need.
}

